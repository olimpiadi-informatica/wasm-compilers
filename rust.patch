+#!/bin/bash
+
+# 1. The Native LLVM you just found
+NATIVE_LLVM_CONFIG="%PWD%/build/llvm-host/bin/llvm-config"
+
+# 2. The WASI LLVM you built
+WASI_LLVM_PREFIX="%PWD%/build/sysroot"
+
+# Get the native prefix
+NATIVE_PREFIX=$($NATIVE_LLVM_CONFIG --prefix)
+
+if [[ "$*" == *"--bindir"* ]]; then
+  $NATIVE_LLVM_CONFIG --bindir
+  exit 0
+fi
+
+if [[ "$*" == *"--system-libs"* ]]; then
+  echo ""
+  exit 0
+fi
+
+# Ask the native llvm-config, but replace the host prefix with your WASI prefix
+OUTPUT=$($NATIVE_LLVM_CONFIG "$@")
+echo "${OUTPUT//$NATIVE_PREFIX/$WASI_LLVM_PREFIX}"
