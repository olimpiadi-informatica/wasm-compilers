+#!/bin/bash
+
+CLANG_CXX="%PWD%/build/llvm-host/bin/clang++"
+SYSROOT="%PWD%/build/sysroot"
+
+# 1. Create an empty array to hold our filtered arguments
+NEW_ARGS=()
+
+# 2. Loop through every argument Cargo/cc-rs passes to us
+for arg in "$@"; do
+  if [ "$arg" = "--target=wasm32-wasi" ]; then
+    # INTERCEPTED: Upgrade the target to the threaded version!
+    NEW_ARGS+=("--target=wasm32-wasip1-threads")
+  else
+    # Otherwise, leave the argument exactly as it is
+    NEW_ARGS+=("$arg")
+  fi
+done
+
+# 3. Execute Clang with our custom flags AND the intercepted argument list
+$CLANG_CXX \
+  -stdlib=libstdc++ \
+  --sysroot=$SYSROOT \
+  -I$SYSROOT/include/c++/15.0.0/wasm32-wasip1 \
+  -I$SYSROOT/include/c++/15.0.0 \
+  -matomics -mbulk-memory -mmutable-globals \
+  "${NEW_ARGS[@]}"
