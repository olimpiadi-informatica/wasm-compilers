+fn format_rust_wasm(text: &str, edition: syntax::Edition) -> Option<String> {
+    let mut config = rustfmt_nightly::Config::default();
+    config.set().emit_mode(rustfmt_nightly::EmitMode::Stdout);
+    config.set().verbose(rustfmt_nightly::Verbosity::Quiet);
+    config.set().show_parse_errors(false);
+    let rustfmt_ed = match edition {
+        syntax::Edition::Edition2015 => rustfmt_nightly::Edition::Edition2015,
+        syntax::Edition::Edition2018 => rustfmt_nightly::Edition::Edition2018,
+        syntax::Edition::Edition2021 => rustfmt_nightly::Edition::Edition2021,
+        syntax::Edition::Edition2024 => rustfmt_nightly::Edition::Edition2024,
+    };
+    config.set().edition(rustfmt_ed);
+    let mut out: Vec<u8> = Vec::with_capacity(text.len() * 2);
+    std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let mut session = rustfmt_nightly::Session::new(config, Some(&mut out));
+        let res = session.format(rustfmt_nightly::Input::Text(text.to_owned()));
