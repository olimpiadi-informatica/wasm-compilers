+#!/bin/bash
+
+WASM_LD="%PWD%/build/llvm-host/bin/wasm-ld"
+SYSROOT="%PWD%/build/sysroot"
+
+NEW_ARGS=()
+SKIP_NEXT=0
+
+# Loop through the arguments and assassinate the "-flavor wasm" combo
+for arg in "$@"; do
+  # If we just saw "-flavor", we must skip the current argument ("wasm")
+  if [ "$SKIP_NEXT" -eq 1 ]; then
+    SKIP_NEXT=0
+    continue
+  fi
+
+  if [ "$arg" = "-flavor" ]; then
+    # We found "-flavor". Skip it, and flag to skip the next argument too.
+    SKIP_NEXT=1
+  else
+    # Otherwise, safely add the argument to our new list
+    NEW_ARGS+=("$arg")
+  fi
+done
+
+# Execute wasm-ld with our custom libraries and the sanitized argument list
+$WASM_LD \
+  -L$SYSROOT/lib/wasm32-wasip1-threads \
+  -L$SYSROOT/lib \
+  "${NEW_ARGS[@]}"
