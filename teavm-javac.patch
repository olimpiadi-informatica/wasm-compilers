+package org.teavm.javac.lsp;
+
+import com.sun.source.tree.Scope;
+import com.sun.source.tree.Tree;
+import com.sun.source.util.TreePath;
+import com.sun.tools.javac.code.Flags;
+import com.sun.tools.javac.code.Symbol;
+import com.sun.tools.javac.code.Type;
+import com.sun.tools.javac.tree.JCTree;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import javax.lang.model.element.Element;
+
+final class CompletionProvider {
+    // LSP CompletionItemKind constants
+    private static final int KIND_METHOD = 2;
+    private static final int KIND_FIELD = 5;
+    private static final int KIND_VARIABLE = 6;
+    private static final int KIND_CLASS = 7;
+    private static final int KIND_INTERFACE = 8;
+    private static final int KIND_MODULE = 9;
+    private static final int KIND_ENUM = 13;
+    private static final int KIND_KEYWORD = 14;
+
+    private static final List<String> KEYWORDS = List.of(
+            "abstract", "boolean", "break", "byte", "case", "catch", "char", "class", "continue",
+            "default", "do", "double", "else", "enum", "extends", "false", "final", "finally",
+            "float", "for", "if", "implements", "import", "instanceof", "int", "interface", "long",
+            "new", "null", "package", "private", "protected", "public", "record", "return", "sealed",
+            "short", "static", "super", "switch", "synchronized", "this", "throw", "throws", "true",
+            "try", "var", "void", "while", "yield");
+
+    private CompletionProvider() {
+    }
+
+    static Map<String, Object> complete(
+            JavacAnalyzer analyzer,
+            SdkIndex sdkIndex,
+            Map<String, SourceDoc> docs,
+            SourceDoc doc,
+            int line,
+            int character) {
+        int offset = doc.offsetAt(line, character);
+
+        // 1. Check import line completion first (instant, no javac needed)
+        List<Object> importItems = tryImportCompletion(sdkIndex, docs, doc, offset);
+        if (importItems != null) {
+            return Json.obj("isIncomplete", false, "items", importItems);
+        }
+
+        // 2. Patch buffer and run javac attribution
+        var patched = JavacAnalyzer.patchForCompletion(doc.text, offset);
+        var analysis = analyzer.analyzeWithOverride(docs, doc.uri, patched.text, false);
+        var unit = analysis.unitsByUri.get(doc.uri);
+        if (unit == null) {
+            return Json.obj("isIncomplete", false, "items", List.of());
+        }
+
+        TreePath markerPath = JavacAnalyzer.findMarkerPath(unit, patched.markerOffset);
+        List<Object> items = new ArrayList<>();
+        String prefixLower = patched.prefix.toLowerCase(Locale.ROOT);
+
+        if (patched.isMemberAccess) {
+            JCTree.JCFieldAccess select = findEnclosingFieldAccess(markerPath);
+            if (select != null && select.selected != null) {
+                Symbol.ClassSymbol enclosingClass = findEnclosingClass(markerPath);
+                String unitPkg = unit.packge != null ? unit.packge.getQualifiedName().toString() : "";
+                completeMemberAccess(analysis, select.selected, enclosingClass, unitPkg, prefixLower, items);
+            }
+        } else {
+            completeLexicalScope(analysis, sdkIndex, docs, doc, unit, markerPath, patched.prefix, prefixLower, items);
+        }
+
+        return Json.obj("isIncomplete", false, "items", items);
+    }
+
+    private static List<Object> tryImportCompletion(
+            SdkIndex sdkIndex,
+            Map<String, SourceDoc> docs,
+            SourceDoc doc,
+            int offset) {
+        int lineStart = doc.text.lastIndexOf('\n', Math.max(0, offset - 1)) + 1;
+        String beforeCursor = doc.text.substring(lineStart, Math.min(offset, doc.text.length())).trim();
+        if (!beforeCursor.startsWith("import ")) {
+            return null;
+        }
+        String rest = beforeCursor.substring("import ".length()).trim();
+        if (rest.startsWith("static ")) {
+            rest = rest.substring("static ".length()).trim();
+        }
+        if (rest.startsWith("module ")) {
+            String modPrefix = rest.substring("module ".length()).trim().toLowerCase(Locale.ROOT);
+            List<Object> items = new ArrayList<>();
+            if ("java.base".startsWith(modPrefix)) {
+                items.add(Json.obj("label", "java.base", "kind", KIND_MODULE));
+            }
+            return items;
+        }
+
+        int lastDot = rest.lastIndexOf('.');
+        String pkg = lastDot >= 0 ? rest.substring(0, lastDot) : "";
+        String prefix = (lastDot >= 0 ? rest.substring(lastDot + 1) : rest).toLowerCase(Locale.ROOT);
+
+        List<Object> items = new ArrayList<>();
+        Set<String> seen = new LinkedHashSet<>();
+
+        for (String sub : sdkIndex.getSubPackages(pkg)) {
+            if (sub.toLowerCase(Locale.ROOT).startsWith(prefix) && seen.add("p:" + sub)) {
+                items.add(Json.obj("label", sub, "kind", KIND_MODULE, "detail", "package"));
+            }
+        }
+        for (String cls : sdkIndex.getClassesInPackage(pkg)) {
+            if (cls.toLowerCase(Locale.ROOT).startsWith(prefix) && seen.add("c:" + cls)) {
+                items.add(Json.obj("label", cls, "kind", KIND_CLASS, "detail", pkg + "." + cls));
+            }
+        }
+        return items;
+    }
+
+    private static JCTree.JCFieldAccess findEnclosingFieldAccess(TreePath path) {
+        TreePath cur = path;
+        while (cur != null) {
+            if (cur.getLeaf() instanceof JCTree.JCFieldAccess fa) {
+                return fa;
+            }
+            cur = cur.getParentPath();
+        }
+        return null;
+    }
+
+    private static Symbol.ClassSymbol findEnclosingClass(TreePath path) {
+        TreePath cur = path;
+        while (cur != null) {
+            if (cur.getLeaf() instanceof JCTree.JCClassDecl cd && cd.sym != null) {
+                return cd.sym;
+            }
+            cur = cur.getParentPath();
+        }
+        return null;
+    }
+
+    private static boolean isAccessible(
+            JavacAnalyzer.AnalysisResult analysis,
+            Symbol sym,
+            Symbol.ClassSymbol enclosingClass,
+            String unitPkg) {
+        long flags = sym.flags();
+        if ((flags & Flags.PUBLIC) != 0) {
+            return true;
+        }
+        if ((flags & Flags.PRIVATE) != 0) {
+            return enclosingClass != null && sym.outermostClass() == enclosingClass.outermostClass();
+        }
+        String symPkg = sym.packge() != null ? sym.packge().getQualifiedName().toString() : "";
+        if (symPkg.equals(unitPkg)) {
+            return true;
+        }
+        if ((flags & Flags.PROTECTED) != 0
+                && enclosingClass != null
+                && sym.owner instanceof Symbol.ClassSymbol owner) {
+            try {
+                return analysis.types.isSubtype(enclosingClass.type, owner.type);
+            } catch (Throwable ignored) {
+                return false;
+            }
+        }
+        return false;
+    }
+
+    private static void completeMemberAccess(
+            JavacAnalyzer.AnalysisResult analysis,
+            JCTree.JCExpression selected,
+            Symbol.ClassSymbol enclosingClass,
+            String unitPkg,
+            String prefixLower,
+            List<Object> items) {
+        Type receiverType = selected.type;
+        if (receiverType == null || receiverType.isErroneous()) {
+            // Try package-qualified access (e.g., java.util.<cursor>)
+            Symbol sym = TreeLocator.symbolOfTree(selected);
+            if (sym instanceof Symbol.PackageSymbol ps) {
+                completePackageMembers(ps, prefixLower, items);
+            }
+            return;
+        }
+
+        if (receiverType instanceof Type.ArrayType) {
+            if ("length".startsWith(prefixLower)) {
+                items.add(Json.obj("label", "length", "kind", KIND_FIELD, "detail", "int", "sortText", "0_length"));
+            }
+            collectClassMembers(analysis, analysis.syms.objectType, analysis.syms.objectType, false, enclosingClass,
+                    unitPkg, prefixLower, new LinkedHashSet<>(), items, true);
+            return;
+        }
+
+        if (receiverType instanceof Type.TypeVar tv) {
+            receiverType = tv.getUpperBound();
+        }
+        if (receiverType == null || receiverType.isErroneous() || !(receiverType.tsym instanceof Symbol.ClassSymbol)) {
+            return;
+        }
+
+        boolean staticOnly = isStaticTypeAccess(selected);
+        Set<String> seen = new LinkedHashSet<>();
+        collectClassMembers(analysis, receiverType, receiverType, staticOnly, enclosingClass, unitPkg, prefixLower,
+                seen, items, false);
+        if (staticOnly && "class".startsWith(prefixLower)) {
+            items.add(Json.obj("label", "class", "kind", KIND_KEYWORD, "detail", "Class", "sortText", "2_class"));
+        }
+    }
+
+    private static void completePackageMembers(
+            Symbol.PackageSymbol ps,
+            String prefixLower,
+            List<Object> items) {
+        var members = ps.members();
+        if (members == null) {
+            return;
+        }
+        Set<String> seen = new LinkedHashSet<>();
+        for (Symbol sym : members.getSymbols()) {
+            String name = sym.name.toString();
+            if (name.isEmpty() || name.contains("$") || !name.toLowerCase(Locale.ROOT).startsWith(prefixLower)) {
+                continue;
+            }
+            if (!seen.add(name)) {
+                continue;
+            }
+            if (sym instanceof Symbol.ClassSymbol cs) {
+                items.add(Json.obj("label", name, "kind", classKind(cs), "detail", cs.getQualifiedName().toString()));
+            } else if (sym instanceof Symbol.PackageSymbol) {
+                items.add(Json.obj("label", name, "kind", KIND_MODULE, "detail", "package"));
+            }
+        }
+    }
+
+    private static void collectClassMembers(
+            JavacAnalyzer.AnalysisResult analysis,
+            Type rootReceiver,
+            Type currentType,
+            boolean staticOnly,
+            Symbol.ClassSymbol enclosingClass,
+            String unitPkg,
+            String prefixLower,
+            Set<String> seen,
+            List<Object> items,
+            boolean isObjectClass) {
+        if (currentType == null || currentType.isErroneous() || !(currentType.tsym instanceof Symbol.ClassSymbol cs)) {
+            return;
+        }
+        boolean isObj = isObjectClass || cs.getQualifiedName().contentEquals("java.lang.Object");
+        var members = cs.members();
+        if (members != null) {
+            for (Symbol sym : members.getSymbols()) {
+                long flags = sym.flags();
+                if ((flags & (Flags.SYNTHETIC | Flags.BRIDGE)) != 0) {
+                    continue;
+                }
+                if (!isAccessible(analysis, sym, enclosingClass, unitPkg)) {
+                    continue;
+                }
+                String name = sym.name.toString();
+                if (name.isEmpty() || name.startsWith("<") || name.contains("$")) {
+                    continue;
+                }
+                if (!matchesPrefix(name, prefixLower)) {
+                    continue;
+                }
+                boolean isStatic = (flags & Flags.STATIC) != 0;
+                if (staticOnly && !isStatic && !(sym instanceof Symbol.ClassSymbol)) {
+                    continue;
+                }
+                if (!staticOnly && isStatic) {
+                    continue;
+                }
+
+                String sortPrefix = isObj ? "2_" : "0_";
+                if (sym instanceof Symbol.MethodSymbol ms) {
+                    Type mt = TypeFormatter.resolveMemberType(analysis.types, rootReceiver, ms);
+                    String params = TypeFormatter.formatMethodParams(ms, mt);
+                    String ret = TypeFormatter.formatMethodReturnType(ms, mt);
+                    String dedupKey = "m:" + name + "(" + TypeFormatter.formatMethodParamTypesKey(ms, mt) + ")";
+                    if (!seen.add(dedupKey)) {
+                        continue;
+                    }
+                    String detail = ret + " " + name + "(" + params + ")";
+                    String insertText = (ms.params() == null || ms.params().isEmpty()) ? name + "()" : name;
+                    items.add(Json.obj(
+                            "label", name,
+                            "kind", KIND_METHOD,
+                            "detail", detail,
+                            "insertText", insertText,
+                            "sortText", sortPrefix + name));
+                } else if (sym instanceof Symbol.VarSymbol vs) {
+                    if (!seen.add("f:" + name)) {
+                        continue;
+                    }
+                    Type vt = TypeFormatter.resolveMemberType(analysis.types, rootReceiver, vs);
+                    items.add(Json.obj(
+                            "label", name,
+                            "kind", KIND_FIELD,
+                            "detail", TypeFormatter.shortType(vt),
+                            "sortText", sortPrefix + name));
+                } else if (sym instanceof Symbol.ClassSymbol nested && staticOnly) {
+                    if (!seen.add("c:" + name)) {
