--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/RuntimeClasslibOverlay.java
@@ -0,0 +1,62 @@
+package org.teavm.javac;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.zip.ZipFile;
+import org.teavm.compiler.bootstrap.ArchiveReader;
+import org.teavm.compiler.bootstrap.tools.ArchiveBuilder;
+
+public class RuntimeClasslibOverlay {
+    private static final String CLASSLIB_ENTRY = "org/teavm/compiler/bootstrap/runtime-classlib-teavm.bin";
+
+    public static void main(String[] args) throws IOException {
+        if (args.length < 2) {
+            throw new IllegalArgumentException("Usage: RuntimeClasslibOverlay <output> <bootstrap-jar> [overlay-dir...]");
+        }
+        var outputPath = Path.of(args[0]);
+        var bootstrapJar = Path.of(args[1]);
+        var entries = new LinkedHashMap<String, byte[]>();
+
+        try (var zip = new ZipFile(bootstrapJar.toFile())) {
+            var entry = zip.getEntry(CLASSLIB_ENTRY);
+            if (entry == null) {
+                throw new IOException(CLASSLIB_ENTRY + " not found in " + bootstrapJar);
+            }
+            try (var reader = new ArchiveReader(zip.getInputStream(entry))) {
+                String name;
+                while ((name = reader.readNext()) != null) {
+                    entries.put(name, reader.readData());
+                }
+            }
+        }
+
+        for (int i = 2; i < args.length; i++) {
+            var dir = Path.of(args[i]);
+            if (!Files.isDirectory(dir)) {
+                continue;
+            }
+            try (var stream = Files.walk(dir)) {
+                stream.forEach(path -> {
+                    if (Files.isRegularFile(path) && path.getFileName().toString().endsWith(".class")) {
+                        var relName = dir.relativize(path).toString().replace('\\', '/');
+                        try {
+                            entries.put(relName, Files.readAllBytes(path));
+                        } catch (IOException e) {
+                            throw new UncheckedIOException(e);
+                        }
+                    }
+                });
+            }
+        }
+
+        Files.createDirectories(outputPath.getParent());
+        try (var builder = new ArchiveBuilder(Files.newOutputStream(outputPath))) {
+            for (var entry : entries.entrySet()) {
+                builder.append(entry.getKey(), entry.getValue());
+            }
+        }
+    }
+}
