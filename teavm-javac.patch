+package org.teavm.classlib.java.util;
+
+import java.io.BufferedReader;
+import java.io.Closeable;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.Reader;
+import java.io.StringReader;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.nio.CharBuffer;
+import java.nio.charset.StandardCharsets;
+import java.util.InputMismatchException;
+import java.util.Iterator;
+import java.util.Locale;
+import java.util.NoSuchElementException;
+import java.util.regex.Pattern;
+
+public final class TScanner implements Iterator<String>, Closeable {
+    private final Reader reader;
+    private final StringBuilder buf = new StringBuilder();
+    private int pos = 0;
+    private boolean eof = false;
+    private boolean closed = false;
+    private int defaultRadix = 10;
+    private Locale locale = Locale.getDefault();
+    private Pattern delimiterPattern = null; // null => default whitespace
+
+    public TScanner(InputStream source) {
+        this(new BufferedReader(new InputStreamReader(source, StandardCharsets.UTF_8)));
+    }
+
+    public TScanner(InputStream source, String charsetName) {
+        this(new BufferedReader(new InputStreamReader(source, StandardCharsets.UTF_8)));
+    }
+
+    public TScanner(File source) throws FileNotFoundException {
+        this(new FileInputStream(source));
+    }
+
+    public TScanner(File source, String charsetName) throws FileNotFoundException {
+        this(new FileInputStream(source), charsetName);
+    }
+
+    public TScanner(String source) {
+        this(new StringReader(source));
+    }
+
+    public TScanner(Readable source) {
+        if (source instanceof Reader) {
+            this.reader = (Reader) source;
+        } else {
+            this.reader = new Reader() {
+                @Override
+                public int read(char[] cbuf, int off, int len) throws IOException {
+                    CharBuffer cb = CharBuffer.wrap(cbuf, off, len);
+                    return source.read(cb);
+                }
+
+                @Override
+                public void close() throws IOException {
+                    if (source instanceof Closeable) {
+                        ((Closeable) source).close();
+                    }
+                }
+            };
+        }
+    }
+
+    private void compact() {
+        if (pos > 0 && pos >= 4096) {
+            buf.delete(0, pos);
+            pos = 0;
+        }
+    }
+
+    private boolean fill() {
+        if (eof || closed) {
+            return false;
+        }
+        compact();
+        char[] tmp = new char[4096];
+        try {
+            int n = reader.read(tmp, 0, tmp.length);
+            if (n < 0) {
+                eof = true;
+                return false;
+            }
+            if (n > 0) {
+                buf.append(tmp, 0, n);
+                return true;
+            }
+            return false;
+        } catch (IOException e) {
+            eof = true;
+            return false;
+        }
+    }
+
+    private boolean ensureAvailable() {
+        if (pos < buf.length()) {
+            return true;
+        }
+        return fill();
+    }
+
+    private String peekToken(boolean consume) {
+        if (closed) {
+            throw new IllegalStateException("Scanner closed");
+        }
+        if (delimiterPattern != null) {
+            return peekTokenRegex(consume);
+        }
+        int cur = pos;
+        // Skip leading whitespace
+        while (true) {
+            while (cur < buf.length() && Character.isWhitespace(buf.charAt(cur))) {
+                cur++;
+            }
+            if (cur < buf.length()) {
+                break;
+            }
+            if (!fill()) {
+                return null;
+            }
+            cur = pos;
+            while (cur < buf.length() && Character.isWhitespace(buf.charAt(cur))) {
+                cur++;
+            }
+            if (cur < buf.length()) {
+                break;
+            }
+        }
+        int start = cur;
+        // Read token characters until whitespace or EOF
+        while (true) {
+            while (cur < buf.length() && !Character.isWhitespace(buf.charAt(cur))) {
+                cur++;
+            }
+            if (cur < buf.length() || eof) {
+                break;
+            }
+            int offset = start - pos;
+            int relCur = cur - pos;
+            if (!fill()) {
+                start = pos + offset;
+                cur = pos + relCur;
+                break;
+            }
+            start = pos + offset;
+            cur = pos + relCur;
+        }
+        String token = buf.substring(start, cur);
+        if (consume) {
+            pos = cur;
+        }
+        return token;
+    }
+
+    private String peekTokenRegex(boolean consume) {
+        while (!eof && fill()) {
+            // Read available input for regex delimiter matching
+        }
+        String rest = buf.substring(pos);
+        var matcher = delimiterPattern.matcher(rest);
+        int start = 0;
+        while (start < rest.length() && matcher.find(start) && matcher.start() == start) {
+            if (matcher.end() == start) {
+                break;
+            }
+            start = matcher.end();
+        }
+        if (start >= rest.length()) {
+            return null;
+        }
+        int end = rest.length();
+        if (matcher.find(start)) {
+            end = matcher.start();
+        }
+        String token = rest.substring(start, end);
+        if (consume) {
+            pos += end;
+        }
+        return token;
+    }
+
+    @Override
+    public boolean hasNext() {
+        return peekToken(false) != null;
+    }
+
+    @Override
+    public String next() {
+        String token = peekToken(true);
+        if (token == null) {
+            throw new NoSuchElementException();
+        }
+        return token;
+    }
+
+    public boolean hasNextLine() {
+        if (closed) {
+            throw new IllegalStateException("Scanner closed");
+        }
+        return ensureAvailable();
+    }
+
+    public String nextLine() {
+        if (closed) {
+            throw new IllegalStateException("Scanner closed");
+        }
+        if (!ensureAvailable()) {
+            throw new NoSuchElementException("No line found");
+        }
+        int cur = pos;
+        while (true) {
+            while (cur < buf.length()) {
+                char c = buf.charAt(cur);
+                if (c == '\n' || c == '\r') {
+                    String line = buf.substring(pos, cur);
+                    pos = cur + 1;
+                    if (c == '\r') {
+                        if (pos < buf.length() || fill()) {
+                            if (pos < buf.length() && buf.charAt(pos) == '\n') {
+                                pos++;
+                            }
+                        }
+                    }
+                    return line;
+                }
+                cur++;
+            }
+            int relCur = cur - pos;
+            if (!fill()) {
+                String line = buf.substring(pos);
+                pos = buf.length();
+                return line;
+            }
+            cur = pos + relCur;
+        }
+    }
+
+    public boolean hasNextInt() {
+        return hasNextInt(defaultRadix);
+    }
+
+    public boolean hasNextInt(int radix) {
+        String t = peekToken(false);
+        if (t == null) {
+            return false;
+        }
+        try {
+            Integer.parseInt(t, radix);
+            return true;
+        } catch (NumberFormatException e) {
+            return false;
+        }
+    }
+
+    public int nextInt() {
+        return nextInt(defaultRadix);
+    }
+
+    public int nextInt(int radix) {
+        String t = next();
+        try {
+            return Integer.parseInt(t, radix);
+        } catch (NumberFormatException e) {
+            throw new InputMismatchException("For input string: \"" + t + "\"");
+        }
+    }
+
+    public boolean hasNextLong() {
+        return hasNextLong(defaultRadix);
+    }
+
+    public boolean hasNextLong(int radix) {
+        String t = peekToken(false);
+        if (t == null) {
+            return false;
+        }
+        try {
+            Long.parseLong(t, radix);
+            return true;
+        } catch (NumberFormatException e) {
+            return false;
+        }
+    }
+
+    public long nextLong() {
+        return nextLong(defaultRadix);
+    }
+
+    public long nextLong(int radix) {
+        String t = next();
+        try {
+            return Long.parseLong(t, radix);
+        } catch (NumberFormatException e) {
+            throw new InputMismatchException("For input string: \"" + t + "\"");
+        }
+    }
+
+    public boolean hasNextShort() {
+        return hasNextShort(defaultRadix);
+    }
