+                importedSimple.add(cls);
+                if (matchesPrefix(cls, prefixLower) && seen.add("c:" + cls)) {
+                    items.add(Json.obj("label", cls, "kind", KIND_CLASS, "detail", pkg + "." + cls, "sortText",
+                            "2_" + cls));
+                }
+            }
+        }
+
+        // 4. Auto-import candidates from SDK when user typed >= 2 chars
+        if (prefix.length() >= 2) {
+            int autoImportLimit = 30;
+            int added = 0;
+            int insertLine = findImportInsertLine(doc, unit);
+            Map<String, Object> insertRange = Json.obj(
+                    "start", Json.obj("line", insertLine, "character", 0),
+                    "end", Json.obj("line", insertLine, "character", 0));
+
+            for (String fqn : sdkIndex.allTopLevelClasses) {
+                int dot = fqn.lastIndexOf('.');
+                if (dot < 0) {
+                    continue;
+                }
+                String pkg = fqn.substring(0, dot);
+                String simple = fqn.substring(dot + 1);
+                if (importedSimple.contains(simple) || wildcardPkgs.contains(pkg)) {
+                    continue;
+                }
+                if (!matchesPrefix(simple, prefixLower) || !seen.add("ai:" + fqn)) {
+                    continue;
+                }
+                items.add(Json.obj(
+                        "label", simple,
+                        "kind", KIND_CLASS,
+                        "detail", fqn + " (auto-import)",
+                        "sortText", "3_" + simple,
+                        "additionalTextEdits", Json.arr(Json.obj(
+                                "range", insertRange,
+                                "newText", "import " + fqn + ";\n"))));
+                if (++added >= autoImportLimit) {
+                    break;
+                }
+            }
+        }
+
+        // 5. Java keywords
+        for (String kw : KEYWORDS) {
+            if (kw.startsWith(prefixLower) && seen.add("k:" + kw)) {
+                items.add(Json.obj("label", kw, "kind", KIND_KEYWORD, "sortText", "4_" + kw));
+            }
+        }
+    }
+
+    private static void addElementIfMatching(
+            JavacAnalyzer.AnalysisResult analysis,
+            Element el,
+            String prefixLower,
+            Set<String> seen,
+            List<Object> items,
+            String sortPrefix) {
+        if (!(el instanceof Symbol sym)) {
+            return;
+        }
+        String name = sym.name.toString();
+        if (name.isEmpty() || name.equals(JavacAnalyzer.COMPLETION_MARKER) || name.startsWith("<")) {
+            return;
+        }
+        if (!matchesPrefix(name, prefixLower)) {
+            return;
+        }
+        if (sym instanceof Symbol.VarSymbol vs) {
+            if (seen.add("v:" + name)) {
+                items.add(Json.obj(
+                        "label", name,
+                        "kind", KIND_VARIABLE,
+                        "detail", TypeFormatter.shortType(vs.type),
+                        "sortText", sortPrefix + name));
+            }
+        } else if (sym instanceof Symbol.MethodSymbol ms) {
+            String params = TypeFormatter.formatMethodParams(ms, ms.type);
+            String ret = TypeFormatter.formatMethodReturnType(ms, ms.type);
+            if (seen.add("m:" + name + "(" + TypeFormatter.formatMethodParamTypesKey(ms, ms.type) + ")")) {
+                items.add(Json.obj(
+                        "label", name,
+                        "kind", KIND_METHOD,
+                        "detail", ret + " " + name + "(" + params + ")",
+                        "sortText", sortPrefix + name));
+            }
+        } else if (sym instanceof Symbol.ClassSymbol cs) {
+            if (seen.add("c:" + name)) {
+                items.add(Json.obj(
+                        "label", name,
+                        "kind", classKind(cs),
+                        "detail", cs.getQualifiedName().toString(),
+                        "sortText", "1_" + name));
+            }
+        }
+    }
+
+    private static int findImportInsertLine(SourceDoc doc, JCTree.JCCompilationUnit unit) {
+        int bestLine = 0;
+        if (unit.getPackage() != null) {
+            int end = TreeLocator.endPos((JCTree) unit.getPackage(), unit);
+            bestLine = doc.positionAt(end)[0] + 1;
+        }
+        for (var imp : unit.getImports()) {
+            int end = TreeLocator.endPos(imp, unit);
+            bestLine = Math.max(bestLine, doc.positionAt(end)[0] + 1);
+        }
+        return bestLine;
+    }
+
+    private static boolean isStaticTypeAccess(JCTree.JCExpression expr) {
+        if (expr instanceof JCTree.JCIdent ident) {
+            return ident.sym instanceof Symbol.ClassSymbol;
+        }
+        if (expr instanceof JCTree.JCFieldAccess fa) {
+            return fa.sym instanceof Symbol.ClassSymbol;
+        }
+        return false;
+    }
+
+    private static boolean isInsideStaticContext(TreePath path) {
+        TreePath cur = path;
+        while (cur != null) {
+            Tree leaf = cur.getLeaf();
+            if (leaf instanceof JCTree.JCMethodDecl md) {
+                return (md.mods.flags & Flags.STATIC) != 0;
+            }
+            if (leaf instanceof JCTree.JCBlock blk && cur.getParentPath() != null
+                    && cur.getParentPath().getLeaf() instanceof JCTree.JCClassDecl) {
+                return (blk.flags & Flags.STATIC) != 0;
+            }
+            if (leaf instanceof JCTree.JCClassDecl) {
+                return false;
+            }
+            cur = cur.getParentPath();
+        }
+        return false;
+    }
+
+    private static int classKind(Symbol.ClassSymbol cs) {
+        long flags = cs.flags();
+        if ((flags & Flags.ENUM) != 0) {
+            return KIND_ENUM;
+        }
+        if ((flags & Flags.INTERFACE) != 0) {
+            return KIND_INTERFACE;
+        }
+        return KIND_CLASS;
+    }
+
+    private static boolean matchesPrefix(String candidate, String prefixLower) {
+        if (prefixLower.isEmpty()) {
+            return true;
+        }
+        return candidate.toLowerCase(Locale.ROOT).startsWith(prefixLower);
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/lsp/HoverProvider.java b/compiler/src/main/java/org/teavm/javac/lsp/HoverProvider.java
new file mode 100644
index 0000000..4f311e3
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/lsp/HoverProvider.java
@@ -0,0 +1,153 @@
+package org.teavm.javac.lsp;
+
+import com.sun.source.util.TreePath;
+import com.sun.tools.javac.code.Flags;
+import com.sun.tools.javac.code.Symbol;
+import com.sun.tools.javac.code.Type;
+import com.sun.tools.javac.tree.JCTree;
+import java.util.Map;
+
+final class HoverProvider {
+    private HoverProvider() {
+    }
+
+    static Map<String, Object> hover(
+            JavacAnalyzer.AnalysisResult analysis,
+            SourceDoc doc,
+            int line,
+            int character) {
+        var unit = analysis.unitsByUri.get(doc.uri);
+        if (unit == null) {
+            return null;
+        }
+        int offset = doc.offsetAt(line, character);
+        TreePath path = TreeLocator.findInnermostPath(unit, offset);
+        if (path == null) {
+            return null;
+        }
+        Symbol sym = TreeLocator.resolveSymbol(path);
+        if (sym == null || sym.type == null || sym.type.isErroneous()) {
+            return null;
+        }
+
+        Type receiverType = null;
+        if (path.getLeaf() instanceof JCTree.JCFieldAccess fa && fa.selected != null) {
+            receiverType = fa.selected.type;
+        } else if (path.getParentPath() != null
+                && path.getParentPath().getLeaf() instanceof JCTree.JCFieldAccess fa
+                && fa.selected != null) {
+            receiverType = fa.selected.type;
+        }
+
+        String text = formatHover(analysis, sym, receiverType);
+        if (text == null || text.isEmpty()) {
+            return null;
+        }
+
+        Map<String, Object> range = null;
+        if (path.getLeaf() instanceof JCTree jc) {
+            int s = TreeLocator.startPos(jc);
+            int e = TreeLocator.endPos(jc, unit);
+            if (s >= 0 && e >= s) {
+                range = doc.range(s, e);
+            }
+        }
+
+        var result = Json.obj(
+                "contents", Json.obj("kind", "markdown", "value", "```java\n" + text + "\n```"));
+        if (range != null) {
+            result.put("range", range);
+        }
+        return result;
+    }
+
+    private static String formatHover(JavacAnalyzer.AnalysisResult analysis, Symbol sym, Type receiverType) {
+        if (sym instanceof Symbol.MethodSymbol ms) {
+            Type mt = TypeFormatter.resolveMemberType(analysis.types, receiverType, ms);
+            var sb = new StringBuilder();
+            sb.append(TypeFormatter.formatModifiers(ms));
+            sb.append(TypeFormatter.formatMethodSignature(ms, mt, true));
+            var thrown = ms.getThrownTypes();
+            if (thrown != null && !thrown.isEmpty()) {
+                sb.append(" throws ");
+                for (int i = 0; i < thrown.size(); i++) {
+                    if (i > 0) {
+                        sb.append(", ");
+                    }
+                    sb.append(TypeFormatter.shortType(thrown.get(i)));
+                }
+            }
+            return sb.toString().trim();
+        }
+        if (sym instanceof Symbol.VarSymbol vs) {
+            Type vt = TypeFormatter.resolveMemberType(analysis.types, receiverType, vs);
+            var sb = new StringBuilder();
+            sb.append(TypeFormatter.formatModifiers(vs));
+            sb.append(TypeFormatter.shortType(vt)).append(' ');
+            if (vs.owner instanceof Symbol.ClassSymbol cs && !cs.name.isEmpty()) {
+                sb.append(cs.name).append('.');
+            }
+            sb.append(vs.name);
+            Object constVal = vs.getConstantValue();
+            if (constVal != null) {
+                sb.append(" = ");
+                if (constVal instanceof String str) {
+                    sb.append('"').append(str).append('"');
+                } else {
+                    sb.append(constVal);
+                }
+            }
+            return sb.toString().trim();
+        }
+        if (sym instanceof Symbol.ClassSymbol cs) {
+            var sb = new StringBuilder();
+            sb.append(TypeFormatter.formatModifiers(cs));
+            long flags = cs.flags();
+            if ((flags & Flags.ENUM) != 0) {
+                sb.append("enum ");
+            } else if ((flags & Flags.RECORD) != 0) {
+                sb.append("record ");
+            } else if ((flags & Flags.ANNOTATION) != 0) {
+                sb.append("@interface ");
+            } else if ((flags & Flags.INTERFACE) != 0) {
+                sb.append("interface ");
+            } else {
+                sb.append("class ");
+            }
+            sb.append(cs.getQualifiedName());
+            var tps = cs.getTypeParameters();
+            if (tps != null && !tps.isEmpty()) {
+                sb.append('<');
+                for (int i = 0; i < tps.size(); i++) {
+                    if (i > 0) {
+                        sb.append(", ");
+                    }
+                    sb.append(tps.get(i).name);
+                }
+                sb.append('>');
+            }
+            Type sup = cs.getSuperclass();
+            if (sup != null && sup.tsym != null
+                    && !sup.tsym.getQualifiedName().contentEquals("java.lang.Object")
+                    && !sup.tsym.getQualifiedName().contentEquals("java.lang.Enum")
+                    && !sup.tsym.getQualifiedName().contentEquals("java.lang.Record")) {
+                sb.append(" extends ").append(TypeFormatter.shortType(sup));
+            }
+            var ifaces = cs.getInterfaces();
+            if (ifaces != null && !ifaces.isEmpty()) {
+                sb.append((flags & Flags.INTERFACE) != 0 ? " extends " : " implements ");
+                for (int i = 0; i < ifaces.size(); i++) {
+                    if (i > 0) {
+                        sb.append(", ");
+                    }
+                    sb.append(TypeFormatter.shortType(ifaces.get(i)));
+                }
+            }
+            return sb.toString().trim();
+        }
+        if (sym instanceof Symbol.PackageSymbol ps) {
+            return "package " + ps.getQualifiedName();
+        }
+        return TypeFormatter.shortType(sym.type) + " " + sym.name;
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/lsp/JavacAnalyzer.java b/compiler/src/main/java/org/teavm/javac/lsp/JavacAnalyzer.java
new file mode 100644
index 0000000..2741afb
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/lsp/JavacAnalyzer.java
@@ -0,0 +1,289 @@
+package org.teavm.javac.lsp;
+
+import com.sun.source.util.SourcePositions;
+import com.sun.source.util.TreePath;
+import com.sun.tools.javac.api.JavacTrees;
+import com.sun.tools.javac.code.Symtab;
+import com.sun.tools.javac.code.Types;
+import com.sun.tools.javac.comp.AttrContext;
+import com.sun.tools.javac.comp.CompileStates.CompileState;
+import com.sun.tools.javac.comp.Env;
+import com.sun.tools.javac.main.JavaCompiler;
+import com.sun.tools.javac.tree.JCTree;
+import com.sun.tools.javac.util.Context;
+import com.sun.tools.javac.util.Names;
+import com.sun.tools.javac.util.Options;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Queue;
+import java.util.Set;
+import javax.tools.Diagnostic;
+import javax.tools.DiagnosticListener;
+import javax.tools.JavaFileManager;
+import javax.tools.JavaFileObject;
+import org.teavm.javac.FileData;
+import org.teavm.javac.FileManagerImpl;
+
+final class JavacAnalyzer {
+    static final String COMPLETION_MARKER = "__teavm_complete__";
+
+    private final Map<String, FileData> sdkFiles;
+
+    JavacAnalyzer(Map<String, FileData> sdkFiles) {
+        this.sdkFiles = sdkFiles;
+    }
+
+    static final class AnalysisResult {
+        final Context context;
+        final JavacTrees trees;
+        final SourcePositions sourcePositions;
+        final Types types;
+        final Symtab syms;
+        final Names names;
+        final Map<String, JCTree.JCCompilationUnit> unitsByUri;
+        final Map<String, List<Diagnostic<? extends JavaFileObject>>> diagnosticsByUri;
+
+        AnalysisResult(
+                Context context,
+                Map<String, JCTree.JCCompilationUnit> unitsByUri,
+                Map<String, List<Diagnostic<? extends JavaFileObject>>> diagnosticsByUri) {
+            this.context = context;
+            this.trees = JavacTrees.instance(context);
+            this.sourcePositions = trees.getSourcePositions();
+            this.types = Types.instance(context);
+            this.syms = Symtab.instance(context);
+            this.names = Names.instance(context);
+            this.unitsByUri = unitsByUri;
+            this.diagnosticsByUri = diagnosticsByUri;
+        }
+    }
+
+    AnalysisResult analyze(Map<String, SourceDoc> docs, boolean runFlow) {
+        return analyzeWithOverride(docs, null, null, runFlow);
+    }
+
+    AnalysisResult analyzeWithOverride(
+            Map<String, SourceDoc> docs,
+            String overrideUri,
+            String overrideText,
+            boolean runFlow) {
+        var sourceFiles = new LinkedHashMap<String, FileData>();
+        var pathToUri = new LinkedHashMap<String, String>();
+        var diagnosticsByUri = new LinkedHashMap<String, List<Diagnostic<? extends JavaFileObject>>>();
+
+        for (var doc : docs.values()) {
+            if (!doc.relPath.endsWith(".java")) {
+                continue;
+            }
+            diagnosticsByUri.put(doc.uri, new ArrayList<>());
+            String content = doc.uri.equals(overrideUri) && overrideText != null ? overrideText : doc.text;
+            var fd = new FileData(sourceFiles);
+            fd.path = doc.relPath;
+            fd.data = content.getBytes(StandardCharsets.UTF_8);
+            fd.lastModified = System.currentTimeMillis();
+            sourceFiles.put(doc.relPath, fd);
+            pathToUri.put(doc.relPath, doc.uri);
+        }
+
+        var context = new Context();
+        Options.instance(context).put("-parameters", "true");
+        Options.instance(context).put("-Xmaxerrs", "100");
+        Options.instance(context).put("-Xmaxwarns", "100");
+        Options.instance(context).put("should-stop.ifError", "ATTR");
+
+        DiagnosticListener<JavaFileObject> listener = diag -> {
+            if (diag.getSource() == null) {
+                return;
+            }
+            String uri = pathToUri.get(diag.getSource().getName());
+            if (uri != null) {
+                diagnosticsByUri.computeIfAbsent(uri, k -> new ArrayList<>()).add(diag);
+            }
+        };
+        context.put(DiagnosticListener.class, listener);
+        var fm = new FileManagerImpl(sourceFiles, new LinkedHashMap<>(), sdkFiles, new LinkedHashMap<>());
+        context.put(JavaFileManager.class, fm);
+
+        var compiler = new LspJavaCompiler(context);
+        compiler.prepare();
+
+        var unitsByUri = new LinkedHashMap<String, JCTree.JCCompilationUnit>();
+        if (!sourceFiles.isEmpty()) {
+            var javaFiles = new ArrayList<JavaFileObject>(sourceFiles.values());
+            var units = compiler.runAnalysis(javaFiles, runFlow);
+            for (var unit : units) {
+                if (unit.sourcefile != null) {
+                    String uri = pathToUri.get(unit.sourcefile.getName());
+                    if (uri != null) {
+                        unitsByUri.put(uri, unit);
+                    }
+                }
+            }
+        }
+        return new AnalysisResult(context, unitsByUri, diagnosticsByUri);
+    }
+
+    static final class PatchedSource {
+        final String text;
+        final int markerOffset;
+        final String prefix;
+        final boolean isMemberAccess;
+
+        PatchedSource(String text, int markerOffset, String prefix, boolean isMemberAccess) {
+            this.text = text;
+            this.markerOffset = markerOffset;
+            this.prefix = prefix;
+            this.isMemberAccess = isMemberAccess;
+        }
+    }
+
+    static PatchedSource patchForCompletion(String text, int cursorOffset) {
+        int clamped = Math.max(0, Math.min(cursorOffset, text.length()));
+        int identStart = clamped;
+        while (identStart > 0 && Character.isJavaIdentifierPart(text.charAt(identStart - 1))) {
+            identStart--;
+        }
+        String prefix = text.substring(identStart, clamped);
+
+        int beforeIdent = identStart;
+        while (beforeIdent > 0 && Character.isWhitespace(text.charAt(beforeIdent - 1))) {
+            beforeIdent--;
+        }
+        boolean isMember = beforeIdent > 0 && text.charAt(beforeIdent - 1) == '.';
+
+        // Avoid patching inside an already valid identifier followed by identifier chars if not needed,
+        // or replace [identStart, clamped] with marker.
+        int replaceEnd = clamped;
+        while (replaceEnd < text.length() && Character.isJavaIdentifierPart(text.charAt(replaceEnd))) {
+            replaceEnd++;
+        }
+
+        // Check if we need a trailing semicolon so javac parses `expr.__teavm_complete__;` cleanly
+        // when the user is mid-statement (e.g. `list.\n}`).
+        int nextNonWs = replaceEnd;
+        while (nextNonWs < text.length()
+                && (text.charAt(nextNonWs) == ' ' || text.charAt(nextNonWs) == '\t')) {
+            nextNonWs++;
+        }
+        boolean needsSemi = false;
+        if (nextNonWs >= text.length()) {
+            needsSemi = true;
+        } else {
+            char nextCh = text.charAt(nextNonWs);
+            if (nextCh == '\n' || nextCh == '\r' || nextCh == '}') {
+                needsSemi = true;
+            }
+        }
+
+        // Don't add ';' inside parentheses like `foo(list.|)` or `if (x.|)`
+        if (needsSemi && isInsideParensOnLine(text, identStart)) {
+            needsSemi = false;
+        }
+
+        char nextCh = nextNonWs < text.length() ? text.charAt(nextNonWs) : '\0';
+        String insertion;
+        if (isMember && nextCh != '(' && nextCh != '.') {
+            insertion = needsSemi ? COMPLETION_MARKER + "();" : COMPLETION_MARKER + "()";
+        } else {
+            insertion = needsSemi ? COMPLETION_MARKER + ";" : COMPLETION_MARKER;
+        }
+        String patched = text.substring(0, identStart) + insertion + text.substring(replaceEnd);
+        return new PatchedSource(patched, identStart, prefix, isMember);
+    }
+
+    private static boolean isInsideParensOnLine(String text, int offset) {
+        int lineStart = text.lastIndexOf('\n', Math.max(0, offset - 1)) + 1;
+        int depth = 0;
+        boolean inStr = false;
+        boolean inChar = false;
+        for (int i = lineStart; i < offset; i++) {
+            char c = text.charAt(i);
+            if (c == '\\' && (inStr || inChar)) {
+                i++;
+                continue;
+            }
+            if (c == '"' && !inChar) {
+                inStr = !inStr;
+            } else if (c == '\'' && !inStr) {
+                inChar = !inChar;
+            } else if (!inStr && !inChar) {
+                if (c == '(') {
+                    depth++;
+                } else if (c == ')' && depth > 0) {
+                    depth--;
+                }
+            }
+        }
+        return depth > 0;
+    }
+
+    static TreePath findMarkerPath(JCTree.JCCompilationUnit unit, int markerOffset) {
+        if (unit != null) {
+            var scanner = new com.sun.source.util.TreePathScanner<TreePath, Void>() {
+                @Override
+                public TreePath visitMemberSelect(com.sun.source.tree.MemberSelectTree node, Void p) {
+                    if (node.getIdentifier().contentEquals(COMPLETION_MARKER)) {
+                        return getCurrentPath();
+                    }
+                    return super.visitMemberSelect(node, p);
+                }
+
+                @Override
+                public TreePath visitIdentifier(com.sun.source.tree.IdentifierTree node, Void p) {
+                    if (node.getName().contentEquals(COMPLETION_MARKER)) {
+                        return getCurrentPath();
+                    }
+                    return super.visitIdentifier(node, p);
+                }
+
+                @Override
+                public TreePath reduce(TreePath r1, TreePath r2) {
+                    return r1 != null ? r1 : r2;
+                }
+            };
+            TreePath found = scanner.scan(unit, null);
+            if (found != null) {
+                return found;
+            }
+        }
+        return TreeLocator.findInnermostPath(unit, markerOffset + 1);
+    }
+
+    private static final class LspJavaCompiler extends JavaCompiler {
+        LspJavaCompiler(Context context) {
+            super(context);
+            this.genEndPos = true;
+            this.shouldStopPolicyIfError = CompileState.ATTR;
+            this.shouldStopPolicyIfNoError = CompileState.FLOW;
+        }
+
+        void prepare() {
+            syms.unnamedModule.visiblePackages = new LinkedHashMap<>();
+            syms.unnamedModule.readModules = Set.of(syms.unnamedModule, syms.java_base);
+            syms.java_base.complete();
+            for (var export : syms.java_base.exports) {
+                syms.unnamedModule.visiblePackages.put(export.packge.fullname, export.packge);
+            }
+        }
+
+        com.sun.tools.javac.util.List<JCTree.JCCompilationUnit> runAnalysis(
+                List<JavaFileObject> files,
+                boolean runFlow) {
+            var units = parseFiles(files);
+            try {
+                units = initModules(units);
+                units = enterTrees(units);
+                Queue<Env<AttrContext>> attributed = attribute(todo);
+                if (runFlow) {
+                    flow(attributed);
+                }
+            } catch (Throwable ignored) {
+                // Best-effort attribution on incomplete/malformed code while user is typing.
+            }
+            return units;
+        }
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/lsp/Json.java b/compiler/src/main/java/org/teavm/javac/lsp/Json.java
new file mode 100644
index 0000000..1d11573
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/lsp/Json.java
@@ -0,0 +1,322 @@
+package org.teavm.javac.lsp;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+final class Json {
+    private Json() {
+    }
+
+    static Object parse(String text) {
+        if (text == null) {
+            return null;
+        }
+        return new Parser(text).parseRoot();
+    }
+
+    static String stringify(Object value) {
+        var sb = new StringBuilder(256);
+        write(value, sb);
+        return sb.toString();
+    }
+
+    @SuppressWarnings("unchecked")
+    static Map<String, Object> asObj(Object value) {
+        return value instanceof Map<?, ?> ? (Map<String, Object>) value : null;
+    }
+
+    @SuppressWarnings("unchecked")
+    static List<Object> asList(Object value) {
+        return value instanceof List<?> ? (List<Object>) value : null;
+    }
+
+    static String asStr(Object value) {
+        return value instanceof String s ? s : null;
+    }
+
+    static int asInt(Object value, int fallback) {
+        if (value instanceof Number n) {
+            return n.intValue();
+        }
+        return fallback;
+    }
+
+    static boolean asBool(Object value, boolean fallback) {
+        if (value instanceof Boolean b) {
+            return b;
+        }
+        return fallback;
+    }
+
+    static Map<String, Object> obj(Object... kv) {
+        var map = new LinkedHashMap<String, Object>();
+        for (int i = 0; i + 1 < kv.length; i += 2) {
+            map.put((String) kv[i], kv[i + 1]);
+        }
+        return map;
+    }
+
+    static List<Object> arr(Object... items) {
+        var list = new ArrayList<Object>(items.length);
+        for (Object item : items) {
+            list.add(item);
+        }
+        return list;
+    }
+
+    private static void write(Object value, StringBuilder sb) {
+        if (value == null) {
+            sb.append("null");
+        } else if (value instanceof Boolean b) {
+            sb.append(b ? "true" : "false");
+        } else if (value instanceof Integer i) {
+            sb.append(i.intValue());
+        } else if (value instanceof Long l) {
+            sb.append(l.longValue());
+        } else if (value instanceof Number n) {
+            double d = n.doubleValue();
+            if (Double.isFinite(d) && d == Math.rint(d) && d >= Long.MIN_VALUE && d <= Long.MAX_VALUE) {
+                sb.append((long) d);
+            } else {
+                sb.append(n);
+            }
+        } else if (value instanceof String s) {
+            writeString(s, sb);
+        } else if (value instanceof Map<?, ?> map) {
+            sb.append('{');
+            boolean first = true;
+            for (var entry : map.entrySet()) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                writeString(String.valueOf(entry.getKey()), sb);
+                sb.append(':');
+                write(entry.getValue(), sb);
+            }
+            sb.append('}');
+        } else if (value instanceof Iterable<?> iter) {
+            sb.append('[');
+            boolean first = true;
+            for (Object item : iter) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                write(item, sb);
+            }
+            sb.append(']');
+        } else {
+            writeString(value.toString(), sb);
+        }
+    }
+
+    private static void writeString(String s, StringBuilder sb) {
+        sb.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            switch (c) {
+                case '"' -> sb.append("\\\"");
+                case '\\' -> sb.append("\\\\");
+                case '\b' -> sb.append("\\b");
+                case '\f' -> sb.append("\\f");
+                case '\n' -> sb.append("\\n");
+                case '\r' -> sb.append("\\r");
+                case '\t' -> sb.append("\\t");
+                default -> {
+                    if (c < 0x20) {
+                        sb.append("\\u00");
+                        sb.append(Character.forDigit((c >> 4) & 0xF, 16));
+                        sb.append(Character.forDigit(c & 0xF, 16));
+                    } else {
+                        sb.append(c);
+                    }
+                }
+            }
+        }
+        sb.append('"');
+    }
+
+    private static final class Parser {
+        private final String s;
+        private int pos;
+
+        Parser(String s) {
+            this.s = s;
+        }
+
+        Object parseRoot() {
+            skipWs();
+            if (pos >= s.length()) {
+                return null;
+            }
+            return parseValue();
+        }
+
+        private void skipWs() {
+            while (pos < s.length()) {
+                char c = s.charAt(pos);
+                if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
+                    pos++;
+                } else {
+                    break;
+                }
+            }
+        }
+
+        private Object parseValue() {
+            skipWs();
+            if (pos >= s.length()) {
+                throw new IllegalArgumentException("Unexpected end of JSON");
+            }
+            char c = s.charAt(pos);
+            return switch (c) {
+                case '{' -> parseObject();
+                case '[' -> parseArray();
+                case '"' -> parseString();
+                case 't' -> parseLiteral("true", Boolean.TRUE);
+                case 'f' -> parseLiteral("false", Boolean.FALSE);
+                case 'n' -> parseLiteral("null", null);
+                default -> parseNumber();
+            };
+        }
+
+        private Object parseLiteral(String lit, Object val) {
+            if (!s.startsWith(lit, pos)) {
+                throw new IllegalArgumentException("Expected " + lit + " at " + pos);
+            }
+            pos += lit.length();
+            return val;
+        }
+
+        private Map<String, Object> parseObject() {
+            pos++; // '{'
+            var map = new LinkedHashMap<String, Object>();
+            skipWs();
+            if (pos < s.length() && s.charAt(pos) == '}') {
+                pos++;
+                return map;
+            }
+            while (pos < s.length()) {
+                skipWs();
+                String key = parseString();
+                skipWs();
+                if (pos >= s.length() || s.charAt(pos) != ':') {
+                    throw new IllegalArgumentException("Expected ':' at " + pos);
+                }
+                pos++;
+                Object val = parseValue();
+                map.put(key, val);
+                skipWs();
+                if (pos < s.length() && s.charAt(pos) == ',') {
+                    pos++;
+                } else if (pos < s.length() && s.charAt(pos) == '}') {
+                    pos++;
+                    return map;
+                } else {
+                    throw new IllegalArgumentException("Expected ',' or '}' at " + pos);
+                }
+            }
+            throw new IllegalArgumentException("Unterminated JSON object");
+        }
+
+        private List<Object> parseArray() {
+            pos++; // '['
+            var list = new ArrayList<Object>();
+            skipWs();
+            if (pos < s.length() && s.charAt(pos) == ']') {
+                pos++;
+                return list;
+            }
+            while (pos < s.length()) {
+                list.add(parseValue());
+                skipWs();
+                if (pos < s.length() && s.charAt(pos) == ',') {
+                    pos++;
+                } else if (pos < s.length() && s.charAt(pos) == ']') {
+                    pos++;
+                    return list;
+                } else {
+                    throw new IllegalArgumentException("Expected ',' or ']' at " + pos);
+                }
+            }
+            throw new IllegalArgumentException("Unterminated JSON array");
+        }
+
+        private String parseString() {
+            if (pos >= s.length() || s.charAt(pos) != '"') {
+                throw new IllegalArgumentException("Expected '\"' at " + pos);
+            }
+            pos++;
+            var sb = new StringBuilder();
+            while (pos < s.length()) {
+                char c = s.charAt(pos++);
+                if (c == '"') {
+                    return sb.toString();
+                }
+                if (c == '\\') {
+                    if (pos >= s.length()) {
+                        throw new IllegalArgumentException("Unterminated escape");
+                    }
+                    char e = s.charAt(pos++);
+                    switch (e) {
+                        case '"', '\\', '/' -> sb.append(e);
+                        case 'b' -> sb.append('\b');
+                        case 'f' -> sb.append('\f');
+                        case 'n' -> sb.append('\n');
+                        case 'r' -> sb.append('\r');
+                        case 't' -> sb.append('\t');
+                        case 'u' -> {
+                            int code = Integer.parseInt(s.substring(pos, pos + 4), 16);
+                            sb.append((char) code);
+                            pos += 4;
+                        }
+                        default -> throw new IllegalArgumentException("Invalid escape \\" + e);
+                    }
+                } else {
+                    sb.append(c);
+                }
+            }
+            throw new IllegalArgumentException("Unterminated JSON string");
+        }
+
+        private Number parseNumber() {
+            int start = pos;
+            if (s.charAt(pos) == '-') {
+                pos++;
+            }
+            while (pos < s.length() && Character.isDigit(s.charAt(pos))) {
+                pos++;
+            }
+            boolean isFloat = false;
+            if (pos < s.length() && s.charAt(pos) == '.') {
+                isFloat = true;
+                pos++;
+                while (pos < s.length() && Character.isDigit(s.charAt(pos))) {
+                    pos++;
+                }
+            }
+            if (pos < s.length() && (s.charAt(pos) == 'e' || s.charAt(pos) == 'E')) {
+                isFloat = true;
+                pos++;
+                if (pos < s.length() && (s.charAt(pos) == '+' || s.charAt(pos) == '-')) {
+                    pos++;
+                }
+                while (pos < s.length() && Character.isDigit(s.charAt(pos))) {
+                    pos++;
+                }
+            }
+            String num = s.substring(start, pos);
+            if (isFloat) {
+                return Double.parseDouble(num);
+            }
+            try {
+                return Long.parseLong(num);
+            } catch (NumberFormatException e) {
+                return Double.parseDouble(num);
+            }
+        }
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/lsp/LanguageServer.java b/compiler/src/main/java/org/teavm/javac/lsp/LanguageServer.java
new file mode 100644
index 0000000..5775b66
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/lsp/LanguageServer.java
@@ -0,0 +1,395 @@
+package org.teavm.javac.lsp;
+
+import com.google.googlejavaformat.java.Formatter;
+import com.google.googlejavaformat.java.FormatterException;
+import com.google.googlejavaformat.java.JavaFormatterOptions;
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import javax.tools.Diagnostic;
+import javax.tools.JavaFileObject;
+import org.teavm.compiler.bootstrap.ArchiveReader;
+import org.teavm.javac.FileData;
+import org.teavm.jso.JSClass;
+import org.teavm.jso.JSExport;
+import org.teavm.jso.typedarrays.Int8Array;
+
+@JSClass(name = "LanguageServer")
+public final class LanguageServer {
+    private final Map<String, FileData> sdkFiles = new LinkedHashMap<>();
+    private final SdkIndex sdkIndex = new SdkIndex();
+    private final JavacAnalyzer analyzer = new JavacAnalyzer(sdkFiles);
+    private final Map<String, SourceDoc> documents = new LinkedHashMap<>();
+    private NotificationHandler notificationHandler;
+    private JavacAnalyzer.AnalysisResult cachedAnalysis;
+    private long revision = 0;
+    private long cachedRevision = -1;
+
+    public LanguageServer() {
+    }
+
+    @JSExport
+    public void setSdk(Int8Array content) throws IOException {
+        sdkFiles.clear();
+        try (var input = new ArchiveReader(new ByteArrayInputStream(content.copyToJavaArray()))) {
+            while (true) {
+                var entry = input.readNext();
+                if (entry == null) {
+                    break;
+                }
+                var fd = new FileData(sdkFiles);
+                fd.path = entry;
+                fd.data = input.readData();
+                fd.lastModified = System.currentTimeMillis();
+                fd.isJavaBase = true;
+                sdkFiles.put(entry, fd);
+            }
+        }
+        sdkIndex.build(sdkFiles.keySet());
+        invalidateCache();
+    }
+
+    @JSExport
+    public void setWorkspaceFile(String uri, String content) {
+        if (uri == null || !uri.endsWith(".java")) {
+            return;
+        }
+        var existing = documents.get(uri);
+        if (existing != null) {
+            existing.setText(content);
+        } else {
+            documents.put(uri, new SourceDoc(uri, content));
+        }
+        invalidateCache();
+    }
+
+    @JSExport
+    public void setNotificationHandler(NotificationHandler handler) {
+        this.notificationHandler = handler;
+    }
+
+    @JSExport
+    public String handleMessage(String jsonRpc) {
+        Object parsed;
+        try {
+            parsed = Json.parse(jsonRpc);
+        } catch (Throwable e) {
+            return Json.stringify(Json.obj(
+                    "jsonrpc", "2.0",
+                    "id", null,
+                    "error", Json.obj("code", -32700, "message", "Parse error: " + e.getMessage())));
+        }
+        Map<String, Object> msg = Json.asObj(parsed);
+        if (msg == null) {
+            return null;
+        }
+        boolean hasId = msg.containsKey("id");
+        Object id = msg.get("id");
+        String method = Json.asStr(msg.get("method"));
+        Map<String, Object> params = Json.asObj(msg.get("params"));
+
+        if (method == null) {
+            return null;
+        }
+
+        try {
+            Object result = dispatch(method, params);
+            if (!hasId) {
+                return null;
+            }
+            return Json.stringify(Json.obj("jsonrpc", "2.0", "id", id, "result", result));
+        } catch (Throwable e) {
+            if (!hasId) {
+                return null;
+            }
+            return Json.stringify(Json.obj(
+                    "jsonrpc", "2.0",
+                    "id", id,
+                    "error", Json.obj("code", -32603, "message",
+                            e.getMessage() != null ? e.getMessage() : e.getClass().getSimpleName())));
+        }
+    }
+
+    private Object dispatch(String method, Map<String, Object> params) {
+        return switch (method) {
+            case "initialize" -> handleInitialize();
+            case "initialized" -> {
+                publishAllDiagnostics();
+                yield null;
+            }
+            case "shutdown" -> null;
+            case "exit" -> null;
+            case "textDocument/didOpen" -> {
+                handleDidOpen(params);
+                yield null;
+            }
+            case "textDocument/didChange" -> {
+                handleDidChange(params);
+                yield null;
+            }
+            case "textDocument/didClose" -> {
+                handleDidClose(params);
+                yield null;
+            }
+            case "textDocument/completion" -> handleCompletion(params);
+            case "textDocument/hover" -> handleHover(params);
+            case "textDocument/signatureHelp" -> handleSignatureHelp(params);
+            case "textDocument/definition", "textDocument/declaration" -> handleDefinition(params);
+            case "textDocument/references" -> handleReferences(params);
+            case "textDocument/rename" -> handleRename(params);
+            case "textDocument/formatting" -> handleFormatting(params);
+            default -> null;
+        };
+    }
+
+    private Map<String, Object> handleInitialize() {
+        return Json.obj(
+                "capabilities", Json.obj(
+                        "textDocumentSync", 1,
+                        "completionProvider", Json.obj(
+                                "triggerCharacters", Json.arr(".")),
+                        "hoverProvider", true,
+                        "signatureHelpProvider", Json.obj(
+                                "triggerCharacters", Json.arr("(", ",")),
+                        "definitionProvider", true,
+                        "declarationProvider", true,
+                        "referencesProvider", true,
+                        "renameProvider", true,
+                        "documentFormattingProvider", true),
+                "serverInfo", Json.obj("name", "teavm-javac-lsp", "version", "0.1.0"));
+    }
+
+    private void handleDidOpen(Map<String, Object> params) {
+        var td = params != null ? Json.asObj(params.get("textDocument")) : null;
+        if (td == null) {
+            return;
+        }
+        String uri = Json.asStr(td.get("uri"));
+        String text = Json.asStr(td.get("text"));
+        if (uri == null || text == null) {
+            return;
+        }
+        var existing = documents.get(uri);
+        if (existing != null) {
+            existing.setText(text);
+        } else {
+            documents.put(uri, new SourceDoc(uri, text));
+        }
+        invalidateCache();
+        publishAllDiagnostics();
+    }
+
+    private void handleDidChange(Map<String, Object> params) {
+        var td = params != null ? Json.asObj(params.get("textDocument")) : null;
+        var changes = params != null ? Json.asList(params.get("contentChanges")) : null;
+        if (td == null || changes == null || changes.isEmpty()) {
+            return;
+        }
+        String uri = Json.asStr(td.get("uri"));
+        if (uri == null) {
+            return;
+        }
+        var doc = documents.computeIfAbsent(uri, u -> new SourceDoc(u, ""));
+        for (Object item : changes) {
+            var change = Json.asObj(item);
+            if (change == null) {
+                continue;
+            }
+            String newText = Json.asStr(change.get("text"));
+            if (newText == null) {
+                continue;
+            }
+            var range = Json.asObj(change.get("range"));
+            if (range == null) {
+                doc.setText(newText);
+            } else {
+                var start = Json.asObj(range.get("start"));
+                var end = Json.asObj(range.get("end"));
+                if (start != null && end != null) {
+                    int sOff = doc.offsetAt(Json.asInt(start.get("line"), 0), Json.asInt(start.get("character"), 0));
+                    int eOff = doc.offsetAt(Json.asInt(end.get("line"), 0), Json.asInt(end.get("character"), 0));
+                    doc.setText(doc.text.substring(0, sOff) + newText + doc.text.substring(eOff));
+                }
+            }
+        }
+        invalidateCache();
+        publishAllDiagnostics();
+    }
+
+    private void handleDidClose(Map<String, Object> params) {
+        var td = params != null ? Json.asObj(params.get("textDocument")) : null;
+        String uri = td != null ? Json.asStr(td.get("uri")) : null;
+        if (uri == null) {
+            return;
+        }
+        documents.remove(uri);
+        invalidateCache();
+        sendNotification("textDocument/publishDiagnostics",
+                Json.obj("uri", uri, "diagnostics", List.of()));
+    }
+
+    private Object handleCompletion(Map<String, Object> params) {
+        var doc = getDoc(params);
+        var pos = getPos(params);
+        if (doc == null || pos == null) {
+            return Json.obj("isIncomplete", false, "items", List.of());
+        }
+        return CompletionProvider.complete(analyzer, sdkIndex, documents, doc, pos[0], pos[1]);
+    }
+
+    private Object handleHover(Map<String, Object> params) {
+        var doc = getDoc(params);
+        var pos = getPos(params);
+        if (doc == null || pos == null) {
+            return null;
+        }
+        return HoverProvider.hover(getAnalysis(), doc, pos[0], pos[1]);
+    }
+
+    private Object handleSignatureHelp(Map<String, Object> params) {
+        var doc = getDoc(params);
+        var pos = getPos(params);
+        if (doc == null || pos == null) {
+            return null;
+        }
+        return SignatureHelpProvider.signatureHelp(analyzer, documents, getAnalysis(), doc, pos[0], pos[1]);
+    }
+
+    private Object handleDefinition(Map<String, Object> params) {
+        var doc = getDoc(params);
+        var pos = getPos(params);
+        if (doc == null || pos == null) {
+            return null;
+        }
+        return NavigationProvider.definition(getAnalysis(), documents, doc, pos[0], pos[1]);
+    }
+
+    private Object handleReferences(Map<String, Object> params) {
+        var doc = getDoc(params);
+        var pos = getPos(params);
+        if (doc == null || pos == null) {
+            return List.of();
+        }
+        var ctx = Json.asObj(params.get("context"));
+        boolean includeDecl = ctx == null || Json.asBool(ctx.get("includeDeclaration"), true);
+        return NavigationProvider.references(getAnalysis(), documents, doc, pos[0], pos[1], includeDecl);
+    }
+
+    private Object handleRename(Map<String, Object> params) {
+        var doc = getDoc(params);
+        var pos = getPos(params);
+        String newName = params != null ? Json.asStr(params.get("newName")) : null;
+        if (doc == null || pos == null || newName == null) {
+            return null;
+        }
+        return NavigationProvider.rename(getAnalysis(), documents, doc, pos[0], pos[1], newName);
+    }
+
+    private Object handleFormatting(Map<String, Object> params) {
+        var doc = getDoc(params);
+        if (doc == null) {
+            return null;
+        }
+        var opts = params != null ? Json.asObj(params.get("options")) : null;
+        int tabSize = opts != null ? Json.asInt(opts.get("tabSize"), 4) : 4;
+        var style = tabSize >= 4 ? JavaFormatterOptions.Style.AOSP : JavaFormatterOptions.Style.GOOGLE;
+        var gjfOpts = JavaFormatterOptions.builder().style(style).build();
+        try {
+            String formatted = new Formatter(gjfOpts).formatSource(doc.text);
+            if (formatted.equals(doc.text)) {
+                return List.of();
+            }
+            return Json.arr(Json.obj("range", doc.fullDocumentRange(), "newText", formatted));
+        } catch (FormatterException e) {
+            return List.of();
+        }
+    }
+
+    private void publishAllDiagnostics() {
+        if (notificationHandler == null) {
+            return;
+        }
+        var analysis = getAnalysis();
+        for (var entry : analysis.diagnosticsByUri.entrySet()) {
+            String uri = entry.getKey();
+            SourceDoc doc = documents.get(uri);
+            if (doc == null) {
+                continue;
+            }
+            List<Object> lspDiags = new ArrayList<>();
+            for (Diagnostic<? extends JavaFileObject> d : entry.getValue()) {
+                int severity = switch (d.getKind()) {
+                    case ERROR -> 1;
+                    case WARNING, MANDATORY_WARNING -> 2;
+                    case NOTE -> 3;
+                    case OTHER -> 4;
+                };
+                int start = d.getStartPosition() >= 0 ? (int) d.getStartPosition()
+                        : (d.getPosition() >= 0 ? (int) d.getPosition() : 0);
+                int end = d.getEndPosition() >= start ? (int) d.getEndPosition() : start;
+                if (end <= start && start < doc.text.length()) {
+                    // Expand zero-width error span to at least the current token/char for visibility
+                    int tokEnd = start + 1;
+                    if (Character.isJavaIdentifierPart(doc.text.charAt(start))) {
+                        while (tokEnd < doc.text.length() && Character.isJavaIdentifierPart(doc.text.charAt(tokEnd))) {
+                            tokEnd++;
+                        }
+                    }
+                    end = tokEnd;
+                }
+                String message = d.getMessage(Locale.ENGLISH);
+                if (message == null || message.isEmpty()) {
+                    message = d.toString();
+                }
+                lspDiags.add(Json.obj(
+                        "range", doc.range(start, end),
+                        "severity", severity,
+                        "source", "javac",
+                        "message", message));
+            }
+            sendNotification("textDocument/publishDiagnostics",
+                    Json.obj("uri", uri, "diagnostics", lspDiags));
+        }
+    }
+
+    private void sendNotification(String method, Object params) {
+        if (notificationHandler != null) {
+            notificationHandler.onNotification(
+                    Json.stringify(Json.obj("jsonrpc", "2.0", "method", method, "params", params)));
+        }
+    }
+
+    private JavacAnalyzer.AnalysisResult getAnalysis() {
+        if (cachedAnalysis == null || cachedRevision != revision) {
+            cachedAnalysis = analyzer.analyze(documents, true);
+            cachedRevision = revision;
+        }
+        return cachedAnalysis;
+    }
+
+    private void invalidateCache() {
+        revision++;
+        cachedAnalysis = null;
+    }
+
+    private SourceDoc getDoc(Map<String, Object> params) {
+        var td = params != null ? Json.asObj(params.get("textDocument")) : null;
+        String uri = td != null ? Json.asStr(td.get("uri")) : null;
+        return uri != null ? documents.get(uri) : null;
+    }
+
+    private int[] getPos(Map<String, Object> params) {
+        var pos = params != null ? Json.asObj(params.get("position")) : null;
+        if (pos == null) {
+            return null;
+        }
+        return new int[] {
+                Json.asInt(pos.get("line"), 0),
+                Json.asInt(pos.get("character"), 0)
+        };
+    }
+}
