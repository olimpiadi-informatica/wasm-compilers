+                        invoke.setReceiver(construct.getReceiver());
+                        construct.replace(invoke);
+                    } else if (insn instanceof InvokeInstruction invoke
+                            && invoke.getMethod().getClassName().equals("com.sun.tools.javac.file.JavacFileManager")
+                            && invoke.getMethod().getName().equals("<init>")) {
+                        invoke.delete();
+                    } else if (insn instanceof InvokeInstruction invoke
+                            && invoke.getMethod().getClassName().equals("java.lang.reflect.Method")
+                            && invoke.getMethod().getName().equals("invoke")) {
