+package org.teavm.javac.lsp;
+
+import com.sun.source.util.TreePath;
+import com.sun.tools.javac.code.Symbol;
+import com.sun.tools.javac.tree.JCTree;
+import com.sun.tools.javac.tree.TreeScanner;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+final class NavigationProvider {
+    private static final Set<String> JAVA_KEYWORDS = Set.of(
+            "abstract", "assert", "boolean", "break", "byte", "case", "catch", "char", "class",
+            "const", "continue", "default", "do", "double", "else", "enum", "extends", "final",
+            "finally", "float", "for", "goto", "if", "implements", "import", "instanceof", "int",
+            "interface", "long", "native", "new", "package", "private", "protected", "public",
+            "return", "short", "static", "strictfp", "super", "switch", "synchronized", "this",
+            "throw", "throws", "transient", "try", "void", "volatile", "while", "true", "false", "null");
+
+    private NavigationProvider() {
+    }
+
+    static Map<String, Object> definition(
+            JavacAnalyzer.AnalysisResult analysis,
+            Map<String, SourceDoc> docs,
+            SourceDoc doc,
+            int line,
+            int character) {
+        Symbol target = resolveTargetSymbol(analysis, doc, line, character);
+        if (target == null) {
+            return null;
+        }
+        Span decl = findDeclaration(analysis, docs, target);
+        if (decl == null && target instanceof Symbol.MethodSymbol ms && ms.isConstructor() && ms.owner != null) {
+            decl = findDeclaration(analysis, docs, ms.owner);
+        }
+        if (decl == null) {
+            return null;
+        }
+        return decl.doc.location(decl.start, decl.end);
+    }
+
+    static List<Object> references(
+            JavacAnalyzer.AnalysisResult analysis,
+            Map<String, SourceDoc> docs,
+            SourceDoc doc,
+            int line,
+            int character,
+            boolean includeDeclaration) {
+        Symbol target = resolveTargetSymbol(analysis, doc, line, character);
+        if (target == null) {
+            return List.of();
+        }
+        List<Span> spans = collectAllOccurrences(analysis, docs, target, includeDeclaration, false);
+        List<Object> result = new ArrayList<>(spans.size());
+        for (Span s : spans) {
+            result.add(s.doc.location(s.start, s.end));
+        }
+        return result;
+    }
+
+    static Map<String, Object> rename(
+            JavacAnalyzer.AnalysisResult analysis,
+            Map<String, SourceDoc> docs,
+            SourceDoc doc,
+            int line,
+            int character,
+            String newName) {
+        if (!isValidIdentifier(newName)) {
+            return null;
+        }
+        Symbol target = resolveTargetSymbol(analysis, doc, line, character);
+        if (target == null) {
+            return null;
+        }
+        // Only allow renaming symbols declared in the workspace (not java.base SDK symbols).
+        Symbol canonical = target;
+        if (canonical instanceof Symbol.MethodSymbol ms && ms.isConstructor() && ms.owner != null) {
+            canonical = ms.owner;
+        }
+        if (findDeclaration(analysis, docs, canonical) == null) {
+            return null;
+        }
+
+        List<Span> spans = collectAllOccurrences(analysis, docs, canonical, true, true);
+        if (spans.isEmpty()) {
+            return null;
+        }
+
+        Map<String, List<Object>> changes = new LinkedHashMap<>();
+        for (Span s : spans) {
+            changes.computeIfAbsent(s.doc.uri, k -> new ArrayList<>())
+                    .add(Json.obj("range", s.doc.range(s.start, s.end), "newText", newName));
+        }
+        return Json.obj("changes", changes);
+    }
+
+    private record Span(SourceDoc doc, int start, int end) {
+    }
+
+    private static Symbol resolveTargetSymbol(
+            JavacAnalyzer.AnalysisResult analysis,
+            SourceDoc doc,
+            int line,
+            int character) {
+        var unit = analysis.unitsByUri.get(doc.uri);
+        if (unit == null) {
+            return null;
+        }
+        int offset = doc.offsetAt(line, character);
+        TreePath path = TreeLocator.findInnermostPath(unit, offset);
+        if (path == null) {
+            return null;
+        }
+        return TreeLocator.resolveSymbol(path);
+    }
+
+    private static Span findDeclaration(
+            JavacAnalyzer.AnalysisResult analysis,
+            Map<String, SourceDoc> docs,
+            Symbol target) {
+        for (var entry : analysis.unitsByUri.entrySet()) {
+            SourceDoc doc = docs.get(entry.getKey());
+            JCTree.JCCompilationUnit unit = entry.getValue();
+            if (doc == null || unit == null) {
+                continue;
+            }
+            var finder = new DeclarationFinder(unit, doc, target);
+            finder.scan(unit);
+            if (finder.found != null) {
+                return finder.found;
+            }
+        }
+        return null;
+    }
+
+    private static List<Span> collectAllOccurrences(
+            JavacAnalyzer.AnalysisResult analysis,
+            Map<String, SourceDoc> docs,
+            Symbol target,
+            boolean includeDeclaration,
+            boolean includeConstructorsForClass) {
+        List<Span> raw = new ArrayList<>();
+        for (var entry : analysis.unitsByUri.entrySet()) {
+            SourceDoc doc = docs.get(entry.getKey());
+            JCTree.JCCompilationUnit unit = entry.getValue();
+            if (doc == null || unit == null) {
+                continue;
+            }
+            var scanner = new ReferenceFinder(unit, doc, target, includeDeclaration, includeConstructorsForClass, raw);
+            scanner.scan(unit);
+        }
+        raw.sort(Comparator.comparing((Span s) -> s.doc.uri).thenComparingInt(s -> s.start));
+        Set<String> seen = new LinkedHashSet<>();
+        List<Span> dedup = new ArrayList<>(raw.size());
+        for (Span s : raw) {
+            if (seen.add(s.doc.uri + ":" + s.start + ":" + s.end)) {
+                dedup.add(s);
+            }
+        }
+        return dedup;
+    }
+
+    private static boolean symbolsMatch(Symbol candidate, Symbol target, boolean includeConstructorsForClass) {
+        if (candidate == null || target == null) {
+            return false;
+        }
+        if (candidate == target || candidate.baseSymbol() == target.baseSymbol()) {
+            return true;
+        }
+        if (includeConstructorsForClass
+                && target instanceof Symbol.ClassSymbol
+                && candidate instanceof Symbol.MethodSymbol ms
+                && ms.isConstructor()
+                && ms.owner == target) {
+            return true;
+        }
+        return false;
+    }
+
+    private static boolean isValidIdentifier(String name) {
+        if (name == null || name.isEmpty() || JAVA_KEYWORDS.contains(name)) {
+            return false;
+        }
+        if (!Character.isJavaIdentifierStart(name.charAt(0))) {
+            return false;
+        }
+        for (int i = 1; i < name.length(); i++) {
+            if (!Character.isJavaIdentifierPart(name.charAt(i))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static final class DeclarationFinder extends TreeScanner {
+        private final JCTree.JCCompilationUnit unit;
+        private final SourceDoc doc;
+        private final Symbol target;
+        Span found;
+
+        DeclarationFinder(JCTree.JCCompilationUnit unit, SourceDoc doc, Symbol target) {
+            this.unit = unit;
+            this.doc = doc;
+            this.target = target;
+        }
+
+        @Override
+        public void visitClassDef(JCTree.JCClassDecl tree) {
+            if (found == null && symbolsMatch(tree.sym, target, false)) {
+                int s = TreeLocator.startPos(tree);
+                int e = TreeLocator.endPos(tree, unit);
+                int[] span = doc.findIdentifierSpan(s, e, tree.name.toString());
+                found = new Span(doc, span[0], span[1]);
+                return;
+            }
+            super.visitClassDef(tree);
+        }
+
+        @Override
+        public void visitMethodDef(JCTree.JCMethodDecl tree) {
+            if (found == null && symbolsMatch(tree.sym, target, false)) {
+                String name = tree.sym.isConstructor()
+                        ? tree.sym.owner.name.toString()
+                        : tree.name.toString();
+                int s = TreeLocator.startPos(tree);
+                int e = TreeLocator.endPos(tree, unit);
+                int[] span = doc.findIdentifierSpan(s, e, name);
+                found = new Span(doc, span[0], span[1]);
+                return;
+            }
+            super.visitMethodDef(tree);
+        }
+
+        @Override
+        public void visitVarDef(JCTree.JCVariableDecl tree) {
+            if (found == null && symbolsMatch(tree.sym, target, false)) {
+                int s = TreeLocator.startPos(tree);
+                int e = tree.init != null ? TreeLocator.startPos(tree.init) : TreeLocator.endPos(tree, unit);
+                int[] span = doc.findLastIdentifierSpan(s, e, tree.name.toString());
+                found = new Span(doc, span[0], span[1]);
+                return;
+            }
+            super.visitVarDef(tree);
+        }
+
+        @Override
+        public void visitTypeParameter(JCTree.JCTypeParameter tree) {
+            if (found == null && tree.type != null && symbolsMatch(tree.type.tsym, target, false)) {
+                int s = TreeLocator.startPos(tree);
+                int e = TreeLocator.endPos(tree, unit);
+                int[] span = doc.findIdentifierSpan(s, e, tree.name.toString());
+                found = new Span(doc, span[0], span[1]);
+                return;
+            }
+            super.visitTypeParameter(tree);
+        }
+    }
+
+    private static final class ReferenceFinder extends TreeScanner {
+        private final JCTree.JCCompilationUnit unit;
+        private final SourceDoc doc;
+        private final Symbol target;
+        private final boolean includeDeclaration;
+        private final boolean includeConstructorsForClass;
+        private final List<Span> out;
+
+        ReferenceFinder(
+                JCTree.JCCompilationUnit unit,
+                SourceDoc doc,
+                Symbol target,
+                boolean includeDeclaration,
+                boolean includeConstructorsForClass,
+                List<Span> out) {
+            this.unit = unit;
+            this.doc = doc;
+            this.target = target;
+            this.includeDeclaration = includeDeclaration;
+            this.includeConstructorsForClass = includeConstructorsForClass;
+            this.out = out;
+        }
+
+        @Override
+        public void visitClassDef(JCTree.JCClassDecl tree) {
+            if (includeDeclaration && symbolsMatch(tree.sym, target, false)) {
+                int[] span = doc.findIdentifierSpan(TreeLocator.startPos(tree), TreeLocator.endPos(tree, unit),
+                        tree.name.toString());
+                out.add(new Span(doc, span[0], span[1]));
+            }
+            super.visitClassDef(tree);
+        }
+
+        @Override
+        public void visitMethodDef(JCTree.JCMethodDecl tree) {
+            if (includeDeclaration && symbolsMatch(tree.sym, target, includeConstructorsForClass)) {
+                String name = tree.sym.isConstructor()
+                        ? tree.sym.owner.name.toString()
+                        : tree.name.toString();
+                // Skip synthetic default constructor whose pos equals class start
+                if (!tree.sym.isConstructor() || (tree.mods.flags & com.sun.tools.javac.code.Flags.GENERATEDCONSTR) == 0) {
+                    int[] span = doc.findIdentifierSpan(TreeLocator.startPos(tree), TreeLocator.endPos(tree, unit),
+                            name);
+                    out.add(new Span(doc, span[0], span[1]));
+                }
+            }
+            super.visitMethodDef(tree);
+        }
+
+        @Override
+        public void visitVarDef(JCTree.JCVariableDecl tree) {
+            if (includeDeclaration && symbolsMatch(tree.sym, target, false)) {
+                int s = TreeLocator.startPos(tree);
+                int e = tree.init != null ? TreeLocator.startPos(tree.init) : TreeLocator.endPos(tree, unit);
+                int[] span = doc.findLastIdentifierSpan(s, e, tree.name.toString());
+                out.add(new Span(doc, span[0], span[1]));
+            }
+            super.visitVarDef(tree);
+        }
+
+        @Override
+        public void visitIdent(JCTree.JCIdent tree) {
+            if (symbolsMatch(tree.sym, target, includeConstructorsForClass)) {
+                int s = TreeLocator.startPos(tree);
+                int e = TreeLocator.endPos(tree, unit);
+                int[] span = doc.findIdentifierSpan(s, e, tree.name.toString());
+                out.add(new Span(doc, span[0], span[1]));
+            }
+            super.visitIdent(tree);
+        }
+
+        @Override
+        public void visitSelect(JCTree.JCFieldAccess tree) {
+            if (symbolsMatch(tree.sym, target, includeConstructorsForClass)) {
+                int s = TreeLocator.startPos(tree);
+                int e = TreeLocator.endPos(tree, unit);
+                int[] span = doc.findLastIdentifierSpan(s, e, tree.name.toString());
+                out.add(new Span(doc, span[0], span[1]));
+            }
+            super.visitSelect(tree);
+        }
+
+        @Override
+        public void visitReference(JCTree.JCMemberReference tree) {
+            if (symbolsMatch(tree.sym, target, includeConstructorsForClass)) {
+                int s = TreeLocator.startPos(tree);
+                int e = TreeLocator.endPos(tree, unit);
+                int[] span = doc.findLastIdentifierSpan(s, e, tree.name.toString());
+                out.add(new Span(doc, span[0], span[1]));
+            }
+            super.visitReference(tree);
+        }
+    }
+}
