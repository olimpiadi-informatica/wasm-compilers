@@ -0,0 +1,111 @@
+package org.teavm.classlib.java.io;
+
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.InputStream;
+import org.teavm.runtime.fs.VirtualFile;
+import org.teavm.runtime.fs.VirtualFileAccessor;
+
+public class TFileInputStream extends InputStream {
+    private VirtualFileAccessor accessor;
+    private InputStream delegate;
+
+    private static boolean isInputTxt(String path) {
+        if (path == null) {
+            return false;
+        }
+        String p = path;
+        while (p.startsWith("./") || p.startsWith("/")) {
+            p = p.startsWith("./") ? p.substring(2) : p.substring(1);
+        }
+        return p.equals("input.txt");
+    }
+
+    public TFileInputStream(TFile file) throws FileNotFoundException {
+        if (isInputTxt(file.getPath())) {
+            this.delegate = System.in;
+            return;
+        }
+        VirtualFile vf = file.findVirtualFile();
+        if (vf == null || !vf.isFile()) {
+            throw new FileNotFoundException(file.getPath());
+        }
+        accessor = vf.createAccessor(true, false, false);
+        if (accessor == null) {
+            throw new FileNotFoundException(file.getPath());
+        }
+    }
+
+    public TFileInputStream(String path) throws FileNotFoundException {
+        this(new TFile(path));
+    }
+
+    public TFileInputStream(TFileDescriptor fd) {
+        if (fd != null && fd.fd == 0) {
+            this.delegate = System.in;
+        }
+    }
+
+    public TFileInputStream(VirtualFileAccessor accessor) {
+        this.accessor = accessor;
+    }
+
+    @Override
+    public int read() throws IOException {
+        if (delegate != null) {
+            return delegate.read();
+        }
+        byte[] buf = new byte[1];
+        int n = read(buf, 0, 1);
+        return n < 0 ? -1 : (buf[0] & 0xFF);
+    }
+
+    @Override
+    public int read(byte[] b, int off, int len) throws IOException {
+        if (delegate != null) {
+            return delegate.read(b, off, len);
+        }
+        if (accessor == null) {
+            throw new IOException("Stream closed");
+        }
+        int n = accessor.read(b, off, len);
+        return n == 0 && len > 0 ? -1 : n;
+    }
+
+    @Override
+    public long skip(long n) throws IOException {
+        if (delegate != null) {
+            return delegate.skip(n);
+        }
+        if (accessor == null) {
+            throw new IOException("Stream closed");
+        }
+        if (n <= 0) {
+            return 0;
+        }
+        int pos = accessor.tell();
+        int size = accessor.size();
+        int toSkip = (int) Math.min(n, size - pos);
+        accessor.skip(toSkip);
+        return toSkip;
+    }
+
+    @Override
+    public int available() throws IOException {
+        if (delegate != null) {
+            return delegate.available();
+        }
+        if (accessor == null) {
+            return 0;
+        }
+        return Math.max(0, accessor.size() - accessor.tell());
+    }
+
+    @Override
+    public void close() throws IOException {
+        if (accessor != null) {
+            accessor.close();
+            accessor = null;
+        }
+    }
+}
diff --git a/compiler/src/classlibEmu/java/org/teavm/classlib/java/io/TFileOutputStream.java b/compiler/src/classlibEmu/java/org/teavm/classlib/java/io/TFileOutputStream.java
