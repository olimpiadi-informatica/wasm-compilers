+                        seen, items, false);
+            }
+            for (Type iface : analysis.types.interfaces(currentType)) {
+                collectClassMembers(analysis, rootReceiver, iface, staticOnly, enclosingClass, unitPkg, prefixLower,
+                        seen, items, false);
+            }
+        }
+    }
+
+    private static void completeLexicalScope(
+            JavacAnalyzer.AnalysisResult analysis,
+            SdkIndex sdkIndex,
+            Map<String, SourceDoc> docs,
+            SourceDoc doc,
+            JCTree.JCCompilationUnit unit,
+            TreePath path,
+            String prefix,
+            String prefixLower,
+            List<Object> items) {
+        Set<String> seen = new LinkedHashSet<>();
