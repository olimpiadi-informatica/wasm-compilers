--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/lsp/SdkIndex.java
@@ -0,0 +1,68 @@
+package org.teavm.javac.lsp;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+final class SdkIndex {
+    final Map<String, Set<String>> subPackages = new HashMap<>();
+    final Map<String, List<String>> classesInPackage = new HashMap<>();
+    final List<String> allTopLevelClasses = new ArrayList<>();
+
+    void build(Set<String> sdkEntries) {
+        subPackages.clear();
+        classesInPackage.clear();
+        allTopLevelClasses.clear();
+
+        Map<String, Set<String>> pkgClasses = new HashMap<>();
+        for (String entry : sdkEntries) {
+            if (!entry.endsWith(".class") || entry.equals("module-info.class")) {
+                continue;
+            }
+            String internal = entry.substring(0, entry.length() - 6);
+            int slash = internal.lastIndexOf('/');
+            if (slash < 0) {
+                continue;
+            }
+            String simple = internal.substring(slash + 1);
+            if (simple.contains("$")) {
+                continue;
+            }
+            String pkg = internal.substring(0, slash).replace('/', '.');
+            if (pkg.contains(".impl") || pkg.startsWith("org.teavm.")) {
+                continue;
+            }
+            pkgClasses.computeIfAbsent(pkg, k -> new TreeSet<>()).add(simple);
+            allTopLevelClasses.add(pkg + "." + simple);
+
+            String cur = pkg;
+            while (true) {
+                int dot = cur.lastIndexOf('.');
+                if (dot < 0) {
+                    subPackages.computeIfAbsent("", k -> new TreeSet<>()).add(cur);
+                    break;
+                }
+                String parent = cur.substring(0, dot);
+                String child = cur.substring(dot + 1);
+                subPackages.computeIfAbsent(parent, k -> new TreeSet<>()).add(child);
+                cur = parent;
+            }
+        }
+        for (var e : pkgClasses.entrySet()) {
+            classesInPackage.put(e.getKey(), new ArrayList<>(e.getValue()));
+        }
+        Collections.sort(allTopLevelClasses);
+    }
+
+    Set<String> getSubPackages(String pkg) {
+        return subPackages.getOrDefault(pkg, Set.of());
+    }
+
+    List<String> getClassesInPackage(String pkg) {
+        return classesInPackage.getOrDefault(pkg, List.of());
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/lsp/SignatureHelpProvider.java b/compiler/src/main/java/org/teavm/javac/lsp/SignatureHelpProvider.java
new file mode 100644
index 0000000..33db935
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/lsp/SignatureHelpProvider.java
@@ -0,0 +1,311 @@
+package org.teavm.javac.lsp;
+
+import com.sun.source.tree.Tree;
+import com.sun.source.util.TreePath;
+import com.sun.tools.javac.code.Flags;
+import com.sun.tools.javac.code.Symbol;
+import com.sun.tools.javac.code.Type;
+import com.sun.tools.javac.tree.JCTree;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+final class SignatureHelpProvider {
+    private SignatureHelpProvider() {
+    }
+
+    static Map<String, Object> signatureHelp(
+            JavacAnalyzer analyzer,
+            Map<String, SourceDoc> docs,
+            JavacAnalyzer.AnalysisResult cached,
+            SourceDoc doc,
+            int line,
+            int character) {
+        int offset = doc.offsetAt(line, character);
+        int openParen = findEnclosingOpenParen(doc.text, offset);
+        if (openParen < 0) {
+            return null;
+        }
+        int activeParam = countTopLevelCommas(doc.text, openParen + 1, offset);
+
+        // Try cached analysis first; if syntax is incomplete around `foo(|`, patch `)` and re-analyze.
+        var analysis = cached;
+        var unit = analysis != null ? analysis.unitsByUri.get(doc.uri) : null;
+        TreePath callPath = unit != null ? findEnclosingCall(unit, offset) : null;
+
+        if (callPath == null) {
+            String patched = doc.text.substring(0, offset) + ");" + doc.text.substring(offset);
+            analysis = analyzer.analyzeWithOverride(docs, doc.uri, patched, false);
+            unit = analysis.unitsByUri.get(doc.uri);
+            if (unit != null) {
+                callPath = findEnclosingCall(unit, offset);
+            }
+        }
+        if (callPath == null || analysis == null) {
+            return null;
+        }
+
+        List<Candidate> candidates = new ArrayList<>();
+        Tree leaf = callPath.getLeaf();
+        if (leaf instanceof JCTree.JCMethodInvocation inv) {
+            collectMethodOverloads(analysis, inv, candidates);
+        } else if (leaf instanceof JCTree.JCNewClass nc) {
+            collectConstructors(analysis, nc, candidates);
+        }
+        if (candidates.isEmpty()) {
+            return null;
+        }
+
+        List<Object> signatures = new ArrayList<>();
+        int activeSig = 0;
+        for (int i = 0; i < candidates.size(); i++) {
+            var c = candidates.get(i);
+            signatures.add(buildSignatureInfo(c.method, c.memberType));
+            int paramCount = c.method.params() != null ? c.method.params().size() : 0;
+            boolean varargs = (c.method.flags() & Flags.VARARGS) != 0;
+            if (activeParam < paramCount || (varargs && paramCount > 0)) {
+                if (activeSig == 0 && i > 0) {
+                    activeSig = i;
+                }
+            }
+        }
+        // Prefer exact match if the chosen one has fewer params
+        for (int i = 0; i < candidates.size(); i++) {
+            var c = candidates.get(i);
+            int paramCount = c.method.params() != null ? c.method.params().size() : 0;
+            boolean varargs = (c.method.flags() & Flags.VARARGS) != 0;
+            if (paramCount > activeParam || (varargs && paramCount > 0)) {
+                activeSig = i;
+                break;
+            }
+        }
+
+        return Json.obj(
+                "signatures", signatures,
+                "activeSignature", activeSig,
+                "activeParameter", activeParam);
+    }
+
+    private record Candidate(Symbol.MethodSymbol method, Type memberType) {
+    }
+
+    private static void collectMethodOverloads(
+            JavacAnalyzer.AnalysisResult analysis,
+            JCTree.JCMethodInvocation inv,
+            List<Candidate> out) {
+        Type receiverType = null;
+        String methodName = null;
+        boolean staticOnly = false;
+
+        if (inv.meth instanceof JCTree.JCFieldAccess fa) {
+            methodName = fa.name.toString();
+            receiverType = fa.selected != null ? fa.selected.type : null;
+            staticOnly = isTypeReference(fa.selected);
+        } else if (inv.meth instanceof JCTree.JCIdent ident) {
+            methodName = ident.name.toString();
+            if (ident.sym instanceof Symbol.MethodSymbol ms && ms.owner instanceof Symbol.ClassSymbol cs) {
+                receiverType = cs.type;
+            }
+        }
+        if (methodName == null || receiverType == null || receiverType.isErroneous() || receiverType.tsym == null) {
+            if (inv.meth instanceof JCTree.JCIdent ident && ident.sym instanceof Symbol.MethodSymbol ms) {
+                out.add(new Candidate(ms, ms.type));
+            } else if (inv.meth instanceof JCTree.JCFieldAccess fa && fa.sym instanceof Symbol.MethodSymbol ms) {
+                out.add(new Candidate(ms, ms.type));
+            }
+            return;
+        }
+
+        Set<String> seen = new LinkedHashSet<>();
+        collectOverloadsInHierarchy(analysis, receiverType, receiverType, methodName, staticOnly, seen, out);
+    }
+
+    private static void collectOverloadsInHierarchy(
+            JavacAnalyzer.AnalysisResult analysis,
+            Type rootReceiver,
+            Type currentType,
+            String methodName,
+            boolean staticOnly,
+            Set<String> seen,
+            List<Candidate> out) {
+        if (currentType == null || currentType.isErroneous() || !(currentType.tsym instanceof Symbol.ClassSymbol cs)) {
+            return;
+        }
+        var members = cs.members();
+        if (members != null) {
+            for (Symbol sym : members.getSymbolsByName(analysis.names.fromString(methodName))) {
+                if (!(sym instanceof Symbol.MethodSymbol ms)) {
+                    continue;
+                }
+                if ((ms.flags() & (Flags.SYNTHETIC | Flags.BRIDGE)) != 0) {
+                    continue;
+                }
+                boolean isStatic = (ms.flags() & Flags.STATIC) != 0;
+                if (staticOnly && !isStatic) {
+                    continue;
+                }
+                Type mt = TypeFormatter.resolveMemberType(analysis.types, rootReceiver, ms);
+                String sigKey = ms.name + "(" + TypeFormatter.formatMethodParamTypesKey(ms, mt) + ")";
+                if (seen.add(sigKey)) {
+                    out.add(new Candidate(ms, mt));
+                }
+            }
+        }
+        Type sup = analysis.types.supertype(currentType);
+        if (sup != null && sup != Type.noType && sup != currentType) {
+            collectOverloadsInHierarchy(analysis, rootReceiver, sup, methodName, staticOnly, seen, out);
+        }
+        for (Type iface : analysis.types.interfaces(currentType)) {
+            collectOverloadsInHierarchy(analysis, rootReceiver, iface, methodName, staticOnly, seen, out);
+        }
+    }
+
+    private static void collectConstructors(
+            JavacAnalyzer.AnalysisResult analysis,
+            JCTree.JCNewClass nc,
+            List<Candidate> out) {
+        Type type = nc.type;
+        if ((type == null || type.isErroneous()) && nc.clazz != null) {
+            type = nc.clazz.type;
+        }
+        if (type == null || type.isErroneous() || !(type.tsym instanceof Symbol.ClassSymbol cs)) {
+            return;
+        }
+        var members = cs.members();
+        if (members == null) {
+            return;
+        }
+        Set<String> seen = new LinkedHashSet<>();
+        for (Symbol sym : members.getSymbolsByName(analysis.names.init)) {
+            if (!(sym instanceof Symbol.MethodSymbol ms)) {
+                continue;
+            }
+            if ((ms.flags() & Flags.SYNTHETIC) != 0) {
+                continue;
+            }
+            Type mt = TypeFormatter.resolveMemberType(analysis.types, type, ms);
+            String sigKey = "(" + TypeFormatter.formatMethodParamTypesKey(ms, mt) + ")";
+            if (seen.add(sigKey)) {
+                out.add(new Candidate(ms, mt));
+            }
+        }
+    }
+
+    private static Map<String, Object> buildSignatureInfo(Symbol.MethodSymbol method, Type memberType) {
+        String label = TypeFormatter.formatMethodSignature(method, memberType, false);
+        var params = method.params();
+        List<Type> paramTypes = memberType instanceof Type.MethodType mt
+                ? mt.argtypes
+                : (method.type instanceof Type.MethodType mt2 ? mt2.argtypes : List.of());
+        boolean isVarArgs = (method.flags() & Flags.VARARGS) != 0;
+        int n = Math.max(params != null ? params.size() : 0, paramTypes != null ? paramTypes.size() : 0);
+
+        List<Object> paramInfos = new ArrayList<>();
+        for (int i = 0; i < n; i++) {
+            Type pt = (paramTypes != null && i < paramTypes.size())
+                    ? paramTypes.get(i)
+                    : (params != null && i < params.size() ? params.get(i).type : null);
+            String typeStr = (isVarArgs && i == n - 1 && pt instanceof Type.ArrayType at)
+                    ? TypeFormatter.shortType(at.elemtype) + "..."
+                    : TypeFormatter.shortType(pt);
+            String pLabel = (params != null && i < params.size() && !params.get(i).name.isEmpty())
+                    ? typeStr + " " + params.get(i).name
+                    : typeStr;
+            paramInfos.add(Json.obj("label", pLabel));
+        }
+        return Json.obj("label", label, "parameters", paramInfos);
+    }
+
+    private static TreePath findEnclosingCall(JCTree.JCCompilationUnit unit, int offset) {
+        TreePath path = TreeLocator.findInnermostPath(unit, offset);
+        while (path != null) {
+            Tree leaf = path.getLeaf();
+            if (leaf instanceof JCTree.JCMethodInvocation || leaf instanceof JCTree.JCNewClass) {
+                return path;
+            }
+            path = path.getParentPath();
+        }
+        return null;
+    }
+
+    private static boolean isTypeReference(JCTree.JCExpression expr) {
+        if (expr instanceof JCTree.JCIdent ident) {
+            return ident.sym instanceof Symbol.ClassSymbol;
+        }
+        if (expr instanceof JCTree.JCFieldAccess fa) {
+            return fa.sym instanceof Symbol.ClassSymbol;
+        }
+        return false;
+    }
+
+    private static int findEnclosingOpenParen(String text, int offset) {
+        int depth = 0;
+        boolean inStr = false;
+        boolean inChar = false;
+        for (int i = Math.min(offset, text.length()) - 1; i >= 0; i--) {
+            char c = text.charAt(i);
+            if (c == '"' && !inChar && (i == 0 || text.charAt(i - 1) != '\\')) {
+                inStr = !inStr;
+                continue;
+            }
+            if (c == '\'' && !inStr && (i == 0 || text.charAt(i - 1) != '\\')) {
+                inChar = !inChar;
+                continue;
+            }
+            if (inStr || inChar) {
+                continue;
+            }
+            if (c == ')') {
+                depth++;
+            } else if (c == '(') {
+                if (depth == 0) {
+                    return i;
+                }
+                depth--;
+            } else if (c == ';' || c == '{' || c == '}') {
+                return -1;
+            }
+        }
+        return -1;
+    }
+
+    private static int countTopLevelCommas(String text, int start, int end) {
+        int commas = 0;
+        int paren = 0;
+        int bracket = 0;
+        int angle = 0;
+        boolean inStr = false;
+        boolean inChar = false;
+        for (int i = Math.max(0, start); i < Math.min(end, text.length()); i++) {
+            char c = text.charAt(i);
+            if (c == '\\' && (inStr || inChar)) {
+                i++;
+                continue;
+            }
+            if (c == '"' && !inChar) {
+                inStr = !inStr;
+            } else if (c == '\'' && !inStr) {
+                inChar = !inChar;
+            } else if (!inStr && !inChar) {
+                if (c == '(') {
+                    paren++;
+                } else if (c == ')' && paren > 0) {
+                    paren--;
+                } else if (c == '[') {
+                    bracket++;
+                } else if (c == ']' && bracket > 0) {
+                    bracket--;
+                } else if (c == '<') {
+                    angle++;
+                } else if (c == '>' && angle > 0) {
+                    angle--;
+                } else if (c == ',' && paren == 0 && bracket == 0 && angle == 0) {
+                    commas++;
+                }
+            }
+        }
+        return commas;
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/lsp/SourceDoc.java b/compiler/src/main/java/org/teavm/javac/lsp/SourceDoc.java
new file mode 100644
index 0000000..8e004e0
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/lsp/SourceDoc.java
@@ -0,0 +1,149 @@
+package org.teavm.javac.lsp;
+
+import java.util.Arrays;
+import java.util.Map;
+
+final class SourceDoc {
+    final String uri;
+    final String relPath;
+    String text;
+    private int[] lineStarts;
+
+    SourceDoc(String uri, String text) {
+        this.uri = uri;
+        this.relPath = uriToRelPath(uri);
+        setText(text);
+    }
+
+    static String uriToRelPath(String uri) {
+        String p = uri;
+        if (p.startsWith("file:///workdir/")) {
+            p = p.substring("file:///workdir/".length());
+        } else if (p.startsWith("file:///")) {
+            p = p.substring("file:///".length());
+        } else if (p.startsWith("file://")) {
+            p = p.substring("file://".length());
+        }
+        while (p.startsWith("/")) {
+            p = p.substring(1);
+        }
+        return p;
+    }
+
+    void setText(String newText) {
+        this.text = newText != null ? newText : "";
+        int lines = 1;
+        for (int i = 0; i < this.text.length(); i++) {
+            if (this.text.charAt(i) == '\n') {
+                lines++;
+            }
+        }
+        int[] starts = new int[lines];
+        int idx = 1;
+        for (int i = 0; i < this.text.length(); i++) {
+            if (this.text.charAt(i) == '\n') {
+                starts[idx++] = i + 1;
+            }
+        }
+        this.lineStarts = starts;
+    }
+
+    int lineCount() {
+        return lineStarts.length;
+    }
+
+    int offsetAt(int line, int character) {
+        if (line < 0) {
+            return 0;
+        }
+        if (line >= lineStarts.length) {
+            return text.length();
+        }
+        int lineStart = lineStarts[line];
+        int lineEnd = (line + 1 < lineStarts.length) ? lineStarts[line + 1] - 1 : text.length();
+        if (lineEnd > lineStart && text.charAt(lineEnd - 1) == '\r') {
+            lineEnd--;
+        }
+        return Math.min(lineStart + Math.max(0, character), lineEnd);
+    }
+
+    int[] positionAt(int offset) {
+        int clamped = Math.max(0, Math.min(offset, text.length()));
+        int idx = Arrays.binarySearch(lineStarts, clamped);
+        int line = idx >= 0 ? idx : (-idx - 2);
+        if (line < 0) {
+            line = 0;
+        }
+        int col = clamped - lineStarts[line];
+        return new int[] { line, col };
+    }
+
+    Map<String, Object> range(int startOffset, int endOffset) {
+        int s = Math.max(0, Math.min(startOffset, text.length()));
+        int e = Math.max(s, Math.min(endOffset, text.length()));
+        int[] sp = positionAt(s);
+        int[] ep = positionAt(e);
+        return Json.obj(
+                "start", Json.obj("line", sp[0], "character", sp[1]),
+                "end", Json.obj("line", ep[0], "character", ep[1]));
+    }
+
+    Map<String, Object> fullDocumentRange() {
+        return range(0, text.length());
+    }
+
+    Map<String, Object> location(int startOffset, int endOffset) {
+        return Json.obj("uri", uri, "range", range(startOffset, endOffset));
+    }
+
+    int[] findIdentifierSpan(int searchStart, int searchEnd, String ident) {
+        if (ident == null || ident.isEmpty()) {
+            int s = Math.max(0, Math.min(searchStart, text.length()));
+            return new int[] { s, Math.min(s + 1, text.length()) };
+        }
+        int from = Math.max(0, Math.min(searchStart, text.length()));
+        int to = Math.max(from, Math.min(searchEnd, text.length()));
+        int pos = from;
+        while (pos <= to - ident.length()) {
+            int found = text.indexOf(ident, pos);
+            if (found < 0 || found + ident.length() > to) {
+                break;
+            }
+            boolean leftOk = found == 0 || !Character.isJavaIdentifierPart(text.charAt(found - 1));
+            int after = found + ident.length();
+            boolean rightOk = after >= text.length() || !Character.isJavaIdentifierPart(text.charAt(after));
+            if (leftOk && rightOk) {
+                return new int[] { found, after };
+            }
+            pos = found + 1;
+        }
+        return new int[] { from, Math.min(from + ident.length(), text.length()) };
+    }
+
+    int[] findLastIdentifierSpan(int searchStart, int searchEnd, String ident) {
+        if (ident == null || ident.isEmpty()) {
+            return findIdentifierSpan(searchStart, searchEnd, ident);
+        }
+        int from = Math.max(0, Math.min(searchStart, text.length()));
+        int to = Math.max(from, Math.min(searchEnd, text.length()));
+        int best = -1;
+        int pos = from;
+        while (pos <= to - ident.length()) {
+            int found = text.indexOf(ident, pos);
+            if (found < 0 || found + ident.length() > to) {
+                break;
+            }
+            boolean leftOk = found == 0 || !Character.isJavaIdentifierPart(text.charAt(found - 1));
+            int after = found + ident.length();
+            boolean rightOk = after >= text.length() || !Character.isJavaIdentifierPart(text.charAt(after));
+            if (leftOk && rightOk) {
+                best = found;
+            }
+            pos = found + 1;
+        }
+        if (best >= 0) {
+            return new int[] { best, best + ident.length() };
+        }
+        return new int[] { from, Math.min(from + ident.length(), text.length()) };
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/lsp/TreeLocator.java b/compiler/src/main/java/org/teavm/javac/lsp/TreeLocator.java
new file mode 100644
index 0000000..32d5e81
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/lsp/TreeLocator.java
@@ -0,0 +1,119 @@
+package org.teavm.javac.lsp;
+
+import com.sun.source.tree.Tree;
+import com.sun.source.util.TreePath;
+import com.sun.source.util.TreePathScanner;
+import com.sun.tools.javac.code.Symbol;
+import com.sun.tools.javac.tree.JCTree;
+import com.sun.tools.javac.tree.TreeInfo;
+
+final class TreeLocator {
+    private TreeLocator() {
+    }
+
+    static TreePath findInnermostPath(JCTree.JCCompilationUnit unit, int offset) {
+        if (unit == null) {
+            return null;
+        }
+        var finder = new OffsetPathFinder(unit, offset);
+        finder.scan(unit, null);
+        return finder.best;
+    }
+
+    static Symbol resolveSymbol(TreePath path) {
+        TreePath cur = path;
+        while (cur != null) {
+            Tree leaf = cur.getLeaf();
+            Symbol sym = symbolOfTree(leaf);
+            if (sym != null) {
+                return sym;
+            }
+            cur = cur.getParentPath();
+        }
+        return null;
+    }
+
+    static Symbol symbolOfTree(Tree leaf) {
+        if (leaf instanceof JCTree.JCIdent ident) {
+            return ident.sym;
+        }
+        if (leaf instanceof JCTree.JCFieldAccess fa) {
+            return fa.sym;
+        }
+        if (leaf instanceof JCTree.JCClassDecl cd) {
+            return cd.sym;
+        }
+        if (leaf instanceof JCTree.JCMethodDecl md) {
+            return md.sym;
+        }
+        if (leaf instanceof JCTree.JCVariableDecl vd) {
+            return vd.sym;
+        }
+        if (leaf instanceof JCTree.JCNewClass nc) {
+            if (nc.constructor != null) {
+                return nc.constructor;
+            }
+            if (nc.clazz instanceof JCTree t) {
+                return TreeInfo.symbol(t);
+            }
+        }
+        if (leaf instanceof JCTree.JCMemberReference mr) {
+            return mr.sym;
+        }
+        if (leaf instanceof JCTree.JCTypeParameter tp && tp.type != null) {
+            return tp.type.tsym;
+        }
+        if (leaf instanceof JCTree t) {
+            return TreeInfo.symbol(t);
+        }
+        return null;
+    }
+
+    static int startPos(JCTree tree) {
+        int p = tree.getStartPosition();
+        return p >= 0 ? p : tree.pos;
+    }
+
+    static int endPos(JCTree tree, JCTree.JCCompilationUnit unit) {
+        int end = unit.endPositions != null ? tree.getEndPosition(unit.endPositions) : -1;
+        return end >= 0 ? end : Math.max(0, startPos(tree));
+    }
+
+    private static final class OffsetPathFinder extends TreePathScanner<Void, Void> {
+        private final JCTree.JCCompilationUnit unit;
+        private final int offset;
+        TreePath best;
+        private int bestSpan = Integer.MAX_VALUE;
+
+        OffsetPathFinder(JCTree.JCCompilationUnit unit, int offset) {
+            this.unit = unit;
+            this.offset = offset;
+        }
+
+        @Override
+        public Void scan(Tree tree, Void p) {
+            if (!(tree instanceof JCTree jc)) {
+                return null;
+            }
+            int start = startPos(jc);
+            int end = endPos(jc, unit);
+            if (start < 0 || end < start) {
+                return super.scan(tree, p);
+            }
+            // Note: for JCTree.JCCompilationUnit, always recurse.
+            if (tree instanceof JCTree.JCCompilationUnit) {
+                best = new TreePath(unit);
+                return super.scan(tree, p);
+            }
+            if (offset < start || offset > end) {
+                return null;
+            }
+            int span = end - start;
+            if (span <= bestSpan) {
+                bestSpan = span;
+                best = new TreePath(getCurrentPath(), tree);
+            }
+            return super.scan(tree, p);
+        }
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/lsp/TypeFormatter.java b/compiler/src/main/java/org/teavm/javac/lsp/TypeFormatter.java
new file mode 100644
index 0000000..661ae2d
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/lsp/TypeFormatter.java
@@ -0,0 +1,178 @@
+package org.teavm.javac.lsp;
+
+import com.sun.tools.javac.code.Flags;
+import com.sun.tools.javac.code.Symbol;
+import com.sun.tools.javac.code.Type;
+import com.sun.tools.javac.code.Types;
+import java.util.List;
+import javax.lang.model.element.Modifier;
+
+final class TypeFormatter {
+    private TypeFormatter() {
+    }
+
+    static String shortType(Type type) {
+        if (type == null) {
+            return "Object";
+        }
+        return switch (type.getTag()) {
+            case BYTE -> "byte";
+            case CHAR -> "char";
+            case SHORT -> "short";
+            case INT -> "int";
+            case LONG -> "long";
+            case FLOAT -> "float";
+            case DOUBLE -> "double";
+            case BOOLEAN -> "boolean";
+            case VOID -> "void";
+            case BOT -> "null";
+            case ARRAY -> shortType(((Type.ArrayType) type).elemtype) + "[]";
+            case TYPEVAR -> type.tsym != null ? type.tsym.name.toString() : type.toString();
+            case WILDCARD -> {
+                var w = (Type.WildcardType) type;
+                yield switch (w.kind) {
+                    case UNBOUND -> "?";
+                    case EXTENDS -> "? extends " + shortType(w.type);
+                    case SUPER -> "? super " + shortType(w.type);
+                };
+            }
+            case CLASS -> {
+                var ct = (Type.ClassType) type;
+                var sb = new StringBuilder();
+                if (ct.tsym != null) {
+                    sb.append(ct.tsym.name.toString());
+                } else {
+                    sb.append(type.toString());
+                }
+                if (ct.typarams_field != null && !ct.typarams_field.isEmpty()) {
+                    sb.append('<');
+                    boolean first = true;
+                    for (Type arg : ct.typarams_field) {
+                        if (!first) {
+                            sb.append(", ");
+                        }
+                        first = false;
+                        sb.append(shortType(arg));
+                    }
+                    sb.append('>');
+                }
+                yield sb.toString();
+            }
+            default -> {
+                String raw = type.toString();
+                yield raw.startsWith("java.lang.") ? raw.substring("java.lang.".length()) : raw;
+            }
+        };
+    }
+
+    static String formatMethodParamTypesKey(Symbol.MethodSymbol method, Type memberType) {
+        var sb = new StringBuilder();
+        List<Type> paramTypes = memberType instanceof Type.MethodType mt
+                ? mt.argtypes
+                : (method.type instanceof Type.MethodType mt2 ? mt2.argtypes : List.of());
+        if (paramTypes != null) {
+            for (int i = 0; i < paramTypes.size(); i++) {
+                if (i > 0) {
+                    sb.append(',');
+                }
+                sb.append(shortType(paramTypes.get(i)));
+            }
+        }
+        return sb.toString();
+    }
+
+    static String formatMethodParams(Symbol.MethodSymbol method, Type memberType) {
+        var sb = new StringBuilder();
+        var params = method.params();
+        List<Type> paramTypes = memberType instanceof Type.MethodType mt
+                ? mt.argtypes
+                : (method.type instanceof Type.MethodType mt2 ? mt2.argtypes : List.of());
+        boolean isVarArgs = (method.flags() & Flags.VARARGS) != 0;
+
+        int n = Math.max(params != null ? params.size() : 0, paramTypes != null ? paramTypes.size() : 0);
+        for (int i = 0; i < n; i++) {
+            if (i > 0) {
+                sb.append(", ");
+            }
+            Type pt = (paramTypes != null && i < paramTypes.size())
+                    ? paramTypes.get(i)
+                    : (params != null && i < params.size() ? params.get(i).type : null);
+            String typeStr;
+            if (isVarArgs && i == n - 1 && pt instanceof Type.ArrayType at) {
+                typeStr = shortType(at.elemtype) + "...";
+            } else {
+                typeStr = shortType(pt);
+            }
+            sb.append(typeStr);
+            if (params != null && i < params.size()) {
+                String pName = params.get(i).name.toString();
+                if (!pName.isEmpty()) {
+                    sb.append(' ').append(pName);
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    static String formatMethodReturnType(Symbol.MethodSymbol method, Type memberType) {
+        if (memberType instanceof Type.MethodType mt) {
+            return shortType(mt.restype);
+        }
+        if (memberType instanceof Type.ForAll fa && fa.qtype instanceof Type.MethodType mt) {
+            return shortType(mt.restype);
+        }
+        return shortType(method.getReturnType());
+    }
+
+    static Type resolveMemberType(Types types, Type receiverType, Symbol sym) {
+        if (receiverType == null || receiverType.isErroneous() || sym == null) {
+            return sym != null ? sym.type : null;
+        }
+        try {
+            Type mt = types.memberType(receiverType, sym);
+            if (mt instanceof Type.ForAll fa) {
+                return fa.qtype;
+            }
+            return mt;
+        } catch (Throwable ignored) {
+            return sym.type;
+        }
+    }
+
+    static String formatModifiers(Symbol sym) {
+        var sb = new StringBuilder();
+        for (Modifier m : sym.getModifiers()) {
+            sb.append(m.toString()).append(' ');
+        }
+        return sb.toString();
+    }
+
+    static String formatMethodSignature(Symbol.MethodSymbol method, Type memberType, boolean includeOwner) {
+        var sb = new StringBuilder();
+        if (!method.type.getTypeArguments().isEmpty() || !method.getTypeParameters().isEmpty()) {
+            var tps = method.getTypeParameters();
+            if (!tps.isEmpty()) {
+                sb.append('<');
+                for (int i = 0; i < tps.size(); i++) {
+                    if (i > 0) {
+                        sb.append(", ");
+                    }
+                    sb.append(tps.get(i).name);
+                }
+                sb.append("> ");
+            }
+        }
+        if (method.isConstructor()) {
+            String ownerName = method.owner != null ? method.owner.name.toString() : "<init>";
+            sb.append(ownerName);
+        } else {
+            sb.append(formatMethodReturnType(method, memberType)).append(' ');
+            if (includeOwner && method.owner != null && !method.owner.name.isEmpty()) {
+                sb.append(method.owner.name).append('.');
+            }
+            sb.append(method.name);
+        }
+        sb.append('(').append(formatMethodParams(method, memberType)).append(')');
+        return sb.toString();
+    }
+}
