@@ -0,0 +1,46 @@
+package org.teavm.classlib.java.lang;
+
+import java.io.IOException;
+import java.io.InputStream;
+import org.teavm.interop.Import;
+
+class TConsoleInputStream extends InputStream {
+    @Import(module = "teavmConsole", name = "readStdin")
+    private static native int readStdin();
+
+    @Import(module = "teavmConsole", name = "readStdinNonBlocking")
+    private static native int readStdinNonBlocking();
+
+    @Override
+    public int read() throws IOException {
+        return readStdin();
+    }
+
+    @Override
+    public int read(byte[] b, int off, int len) throws IOException {
+        if (b == null) {
+            throw new NullPointerException();
+        }
+        if (off < 0 || len < 0 || len > b.length - off) {
+            throw new IndexOutOfBoundsException();
+        }
+        if (len == 0) {
+            return 0;
+        }
+        int first = readStdin();
+        if (first < 0) {
+            return -1;
+        }
+        b[off] = (byte) first;
+        int count = 1;
+        while (count < len) {
+            int next = readStdinNonBlocking();
+            if (next < 0) {
+                break;
+            }
+            b[off + count] = (byte) next;
+            count++;
+        }
+        return count;
+    }
+}
