@@ -0,0 +1,114 @@
+package org.teavm.classlib.java.io;
+
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.OutputStream;
+import org.teavm.runtime.fs.VirtualFile;
+import org.teavm.runtime.fs.VirtualFileAccessor;
+
+public class TFileOutputStream extends OutputStream {
+    private VirtualFileAccessor accessor;
+    private OutputStream delegate;
+
+    private static boolean isOutputTxt(String path) {
+        if (path == null) {
+            return false;
+        }
+        String p = path;
+        while (p.startsWith("./") || p.startsWith("/")) {
+            p = p.startsWith("./") ? p.substring(2) : p.substring(1);
+        }
+        return p.equals("output.txt");
+    }
+
+    public TFileOutputStream(TFile file) throws FileNotFoundException {
+        this(file, false);
+    }
+
+    public TFileOutputStream(String path) throws FileNotFoundException {
+        this(new TFile(path), false);
+    }
+
+    public TFileOutputStream(String path, boolean append) throws FileNotFoundException {
+        this(new TFile(path), append);
+    }
+
+    public TFileOutputStream(TFile file, boolean append) throws FileNotFoundException {
+        if (isOutputTxt(file.getPath())) {
+            this.delegate = System.out;
+            return;
+        }
+        VirtualFile vf = file.findVirtualFile();
+        if (vf == null) {
+            try {
+                file.createNewFile();
+            } catch (IOException e) {
+                throw new FileNotFoundException(file.getPath());
+            }
+            vf = file.findVirtualFile();
+        }
+        if (vf == null || !vf.isFile()) {
+            throw new FileNotFoundException(file.getPath());
+        }
+        accessor = vf.createAccessor(false, true, append);
+        if (accessor == null) {
+            throw new FileNotFoundException(file.getPath());
+        }
+    }
+
+    public TFileOutputStream(TFileDescriptor fd) {
+        if (fd != null && fd.fd == 1) {
+            this.delegate = System.out;
+        } else if (fd != null && fd.fd == 2) {
+            this.delegate = System.err;
+        }
+    }
+
+    public TFileOutputStream(VirtualFileAccessor accessor) {
+        this.accessor = accessor;
+    }
+
+    @Override
+    public void write(int b) throws IOException {
+        if (delegate != null) {
+            delegate.write(b);
+            return;
+        }
+        write(new byte[] { (byte) b }, 0, 1);
+    }
+
+    @Override
+    public void write(byte[] b, int off, int len) throws IOException {
+        if (delegate != null) {
+            delegate.write(b, off, len);
+            return;
+        }
+        if (accessor == null) {
+            throw new IOException("Stream closed");
+        }
+        accessor.write(b, off, len);
+    }
+
+    @Override
+    public void flush() throws IOException {
+        if (delegate != null) {
+            delegate.flush();
+            return;
+        }
+        if (accessor != null) {
+            accessor.flush();
+        }
+    }
+
+    @Override
+    public void close() throws IOException {
+        if (delegate != null) {
+            delegate.flush();
+            return;
+        }
+        if (accessor != null) {
+            accessor.close();
+            accessor = null;
+        }
+    }
+}
diff --git a/compiler/src/classlibEmu/java/org/teavm/classlib/java/lang/TConsoleInputStream.java b/compiler/src/classlibEmu/java/org/teavm/classlib/java/lang/TConsoleInputStream.java
