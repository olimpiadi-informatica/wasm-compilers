+        var logType = ValueType.object("com.sun.tools.javac.util.Log");
+        var ddhType = ValueType.object("com.sun.tools.javac.util.Log$DeferredDiagnosticHandler");
+        var ddh = cls.getMethod(new MethodDescriptor("deferredDiagnosticHandler", logType, ddhType));
+        if (ddh != null) {
+            var pe = ProgramEmitter.create(ddh, context.getHierarchy());
+            pe.invoke("org.teavm.javac.GjfCompat", "deferredDiagnosticHandler", ddhType,
+                    pe.var(1, logType)).returnValue();
+        }
+
+        var buildToks = cls.getMethod(new MethodDescriptor("buildToks",
+                ValueType.object("java.lang.String"),
+                ValueType.object("com.google.common.collect.ImmutableSet"),
+                ValueType.object("com.google.common.collect.ImmutableList")));
+        if (buildToks != null) {
